---
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import KineticAbout from '../components/KineticAbout.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import GeniusphereFeature from '../components/GeniusphereFeature.astro';
import SkillsEducation from '../components/SkillsEducation.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import CurrentlyStatus from '../components/CurrentlyStatus.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="PAVAN KUMAR — Personal Digital Archive & Geniusphere">
  <Loader />
  <CommandPalette />
  <Header />
  
  <main class="w-full">
    <Hero />
    <KineticAbout />
    <ExperienceSection />
    <JourneyTimeline />
    <GeniusphereFeature />
    <SkillsEducation />
    <CertificationsSection />
    <CurrentlyStatus />
    <ContactSection />
  </main>
</Layout>
