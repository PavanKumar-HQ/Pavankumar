---
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import KineticAbout from '../components/KineticAbout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import WorkArchive from '../components/WorkArchive.astro';
import BrandexFeature from '../components/BrandexFeature.astro';
import GeniusphereFeature from '../components/GeniusphereFeature.astro';
import SystemsOS from '../components/SystemsOS.astro';
import WritingList from '../components/WritingList.astro';
import CurrentlyStatus from '../components/CurrentlyStatus.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience">
  <Loader />
  <CommandPalette />
  <Header />
  
  <main class="w-full">
    <Hero />
    <KineticAbout />
    <JourneyTimeline />
    <WorkArchive />
    <BrandexFeature />
    <GeniusphereFeature />
    <SystemsOS />
    <WritingList />
    <CurrentlyStatus />
    <ContactSection />
  </main>
</Layout>
