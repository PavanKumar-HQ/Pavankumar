---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience", 
  description = "Developer, Entrepreneur, Technologist, Community Builder. Personal archive, interactive magazine, and project showcase." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pavan Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F3F1EB] text-[#0A0F14] selection:bg-[#FFD83D] selection:text-[#0A0F14] relative">
    
    <!-- Custom Neo-Brutalist Cursor Follower -->
    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <slot />
    
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Custom Neo-Brutalist Cursor Dynamics
      const cursor = document.getElementById('cursor');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out'
          });
        });

        // Hover expansions on interactive elements
        document.querySelectorAll('a, button, [role="button"], .brutal-shadow-hover').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '36px';
            cursor.style.height = '36px';
            cursor.style.backgroundColor = '#FF6B22';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = '#FFD83D';
          });
        });
      }
    </script>
  </body>
</html>
