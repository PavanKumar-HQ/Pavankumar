---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience", 
  description = "Developer, Entrepreneur, Technologist, Community Builder. Personal archive, interactive magazine, and project showcase." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pavan Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F3F1EB] text-[#0A0F14] selection:bg-[#FFD83D] selection:text-[#0A0F14] relative overflow-x-hidden">
    
    <!-- Neo-Brutalist Kinetic Preloader Screen -->
    <div id="preloader" class="fixed inset-0 z-[9999] bg-[#F3F1EB] bg-grid-pattern flex flex-col items-center justify-center p-6 select-none overflow-hidden">
      
      <!-- Floating Background Decorative Brutalist Shapes -->
      <div class="absolute top-12 left-12 w-16 h-16 bg-[#FFD83D] border-4 border-[#0A0F14] shadow-[6px_6px_0px_0px_#0A0F14] rotate-12 flex items-center justify-center font-heading font-black text-2xl animate-bounce-slow">
        ★
      </div>
      <div class="absolute top-20 right-16 w-14 h-14 bg-[#FF6B22] border-4 border-[#0A0F14] shadow-[6px_6px_0px_0px_#0A0F14] -rotate-12 flex items-center justify-center font-heading font-black text-xl text-white animate-pulse-gentle">
        [P]
      </div>
      <div class="absolute bottom-16 left-16 w-14 h-14 bg-[#54D69A] border-4 border-[#0A0F14] shadow-[6px_6px_0px_0px_#0A0F14] rotate-6 flex items-center justify-center font-heading font-black text-2xl">
        ⚡
      </div>
      <div class="absolute bottom-20 right-20 w-16 h-16 bg-[#DCC5FF] border-4 border-[#0A0F14] shadow-[6px_6px_0px_0px_#0A0F14] -rotate-6 flex items-center justify-center font-heading font-black text-2xl">
        ⌘
      </div>

      <!-- Preloader Central Card with Kinetic Breathing Zoom -->
      <div id="preloader-card" class="bg-white border-4 border-[#0A0F14] shadow-[12px_12px_0px_0px_#0A0F14] p-8 sm:p-10 max-w-md w-full flex flex-col items-center gap-6 rounded-3xl relative z-10 overflow-hidden">
        
        <!-- Status Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#FFD83D] text-[#0A0F14] font-mono-tech text-xs font-bold uppercase brutal-border-thick rotate-1 shadow-[3px_3px_0px_0px_#0A0F14]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B22] animate-ping"></span>
          <span>INITIALIZING ARCHIVE...</span>
        </div>

        <!-- Branding Header -->
        <div class="text-center">
          <h2 class="font-heading font-black text-4xl sm:text-5xl uppercase tracking-tighter text-[#0A0F14]">
            PAVAN KUMAR
          </h2>
          <p class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest mt-1">
            DIGITAL PORTFOLIO 2026
          </p>
        </div>

        <!-- Rhythmic Neo-Brutalist Equalizer Audio Bars -->
        <div class="flex items-end justify-center gap-1.5 h-16 w-full py-2">
          <div class="w-3 bg-[#FF6B22] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.1s"></div>
          <div class="w-3 bg-[#4A9EFF] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.25s"></div>
          <div class="w-3 bg-[#54D69A] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.4s"></div>
          <div class="w-3 bg-[#FFD83D] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.15s"></div>
          <div class="w-3 bg-[#DCC5FF] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.3s"></div>
          <div class="w-3 bg-[#FF6B22] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.5s"></div>
          <div class="w-3 bg-[#4A9EFF] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.2s"></div>
          <div class="w-3 bg-[#54D69A] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.35s"></div>
          <div class="w-3 bg-[#FFD83D] border-3 border-[#0A0F14] rounded-t-md animate-[eq_0.8s_ease-in-out_infinite_alternate]" style="animation-delay: 0.45s"></div>
        </div>

        <!-- Neo-Brutalist Horizontal Progress Bar Container -->
        <div class="w-full space-y-3">
          <div class="w-full h-8 bg-[#F3F1EB] border-4 border-[#0A0F14] p-1 rounded-xl flex items-center shadow-[4px_4px_0px_0px_#0A0F14] relative overflow-hidden">
            <!-- Dynamic Color Fill -->
            <div id="loading-bar-fill" class="h-full w-0 bg-gradient-to-r from-[#FF6B22] via-[#FFD83D] to-[#54D69A] border-r-3 border-[#0A0F14] rounded-lg transition-all duration-75 ease-out"></div>
          </div>

          <!-- Progress Percentage Counter & Status -->
          <div class="flex items-center justify-between font-mono-tech font-black text-xs sm:text-sm text-[#0A0F14]">
            <span id="loading-status-text">LOADING ASSETS</span>
            <span id="loading-percent" class="px-2 py-0.5 bg-[#4A9EFF] text-white border-2 border-[#0A0F14] rounded-md shadow-[2px_2px_0px_0px_#0A0F14]">0%</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Custom Neo-Brutalist Cursor Follower -->
    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <!-- Entire Website Main Camera Wrapper Container with 3D Perspective -->
    <div id="main-wrapper" class="w-full origin-center scale-[1.25] blur-[10px] opacity-0 transition-all duration-300 pointer-events-none transform-gpu" style="perspective: 1200px;">
      <slot />
    </div>
    
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Preloader Simulation & 3D Cinematic Camera Zoom Entrance
      const preloader = document.getElementById('preloader');
      const preloaderCard = document.getElementById('preloader-card');
      const loadingBarFill = document.getElementById('loading-bar-fill');
      const loadingPercent = document.getElementById('loading-percent');
      const loadingStatusText = document.getElementById('loading-status-text');
      const mainWrapper = document.getElementById('main-wrapper');

      if (preloader && loadingBarFill && loadingPercent && preloaderCard && mainWrapper) {
        let progress = 0;
        const statusPhrases = [
          "COMPILING MODULES",
          "MOUNTING 3D KEYBOARD",
          "RENDERING ARCHIVE",
          "WELCOME!"
        ];

        // Synthesize progress audio tick
        function playProgressTick() {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(850, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(320, ctx.currentTime + 0.02);
            gain.gain.setValueAtTime(0.12, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.02);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.02);
          } catch (e) {}
        }

        const loadInterval = setInterval(() => {
          progress += Math.floor(Math.random() * 2) + 1;
          if (progress > 100) progress = 100;

          loadingBarFill.style.width = `${progress}%`;
          loadingPercent.innerText = `${progress}%`;

          if (progress < 30) {
            loadingStatusText.innerText = statusPhrases[0];
          } else if (progress < 65) {
            loadingStatusText.innerText = statusPhrases[1];
          } else if (progress < 95) {
            loadingStatusText.innerText = statusPhrases[2];
          } else {
            loadingStatusText.innerText = statusPhrases[3];
          }

          if (progress % 20 === 0) {
            playProgressTick();
          }

          if (progress >= 100) {
            clearInterval(loadInterval);

            // 3D Cinematic Camera Zoom-In & Grand Pull-Back Zoom-Out Reveal
            const tl = gsap.timeline();

            // Phase 1: Preloader Card Dip & Burst
            tl.to(preloaderCard, {
              scale: 0.88,
              duration: 0.2,
              ease: 'power2.in'
            })
            .to(preloaderCard, {
              scale: 1.45,
              opacity: 0,
              duration: 0.35,
              ease: 'power3.in'
            })
            .to(preloader, {
              opacity: 0,
              duration: 0.35,
              onComplete: () => {
                preloader.style.display = 'none';
                mainWrapper.classList.remove('pointer-events-none');
              }
            }, '-=0.2')

            // Phase 2: ENTIRE WEBSITE CINEMATIC CAMERA ZOOM IN (Push Forward)
            .to(mainWrapper, {
              scale: 1.32,
              opacity: 0.6,
              duration: 0.3,
              ease: 'power2.in'
            }, '-=0.55')

            // Phase 3: GRAND CINEMATIC CAMERA PULL-BACK ZOOM OUT (From 1.32 -> 0.97 -> 1.0)
            .to(mainWrapper, {
              scale: 1.0,
              filter: 'blur(0px)',
              opacity: 1,
              duration: 1.3,
              ease: 'power4.out'
            }, '-=0.25');
          }
        }, 35);
      }

      // Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Custom Neo-Brutalist Cursor Dynamics
      const cursor = document.getElementById('cursor');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out'
          });
        });

        // Hover expansions on interactive elements
        document.querySelectorAll('a, button, [role="button"], .brutal-shadow-hover').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '36px';
            cursor.style.height = '36px';
            cursor.style.backgroundColor = '#FF6B22';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = '#FFD83D';
          });
        });
      }

      // GSAP Left-to-Right Section Sweep Line Animation on Scroll Entrance
      const sections = document.querySelectorAll('section');
      sections.forEach((section) => {
        const sweepLine = document.createElement('div');
        sweepLine.className = 'section-sweep-line';
        section.appendChild(sweepLine);

        gsap.fromTo(sweepLine, 
          { width: '0%' },
          {
            width: '100%',
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: section,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      });
    </script>
  </body>
</html>
