---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience", 
  description = "Developer, Entrepreneur, Technologist, Community Builder. Personal archive, interactive magazine, and project showcase." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pavan Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F3F1EB] text-[#0A0F14] selection:bg-[#FFD83D] selection:text-[#0A0F14] relative overflow-x-hidden">
    
    <!-- Neo-Brutalist Massive Progress Bar Preloader -->
    <div id="preloader" class="fixed inset-0 z-[9999] bg-[#0A0F14] flex flex-col items-center justify-center p-6 select-none overflow-hidden">
      
      <!-- Decorative Background Grid Lines (Subtle on dark) -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

      <!-- Floating Decorative Corner Badges -->
      <div class="absolute top-8 left-8 hidden sm:flex items-center gap-2 px-3 py-1 bg-[#FFD83D] text-[#0A0F14] font-mono-tech text-xs font-bold border-2 border-[#FFD83D] shadow-[3px_3px_0px_0px_#FF6B22] -rotate-3">
        ★ BENGALURU, INDIA
      </div>
      <div class="absolute top-8 right-8 hidden sm:flex items-center gap-2 px-3 py-1 bg-[#4A9EFF] text-white font-mono-tech text-xs font-bold border-2 border-[#4A9EFF] shadow-[3px_3px_0px_0px_#54D69A] rotate-3">
        SYSTEM BOOT 2026
      </div>

      <!-- Preloader Central Focus -->
      <div id="preloader-content" class="w-full max-w-2xl flex flex-col items-center gap-6 relative z-10">
        
        <!-- Large Percentage Display -->
        <div class="text-[#F3F1EB] font-heading font-black text-7xl sm:text-9xl tracking-tighter tabular-nums drop-shadow-[6px_6px_0px_#FF6B22]">
          <span id="loading-percent">0</span>%
        </div>

        <!-- System Status Text -->
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-[#F3F1EB] text-[#0A0F14] font-mono-tech text-sm sm:text-base font-bold uppercase border-4 border-[#0A0F14] shadow-[6px_6px_0px_0px_#FF6B22] -rotate-1">
          <span class="w-3 h-3 rounded-full bg-[#FF6B22] animate-ping"></span>
          <span id="loading-status-text">INITIALIZING ASSETS...</span>
        </div>

        <!-- Massive Segmented Progress Bar -->
        <div class="w-full h-12 sm:h-16 mt-4 bg-[#F3F1EB] border-4 border-[#0A0F14] p-1.5 flex items-center shadow-[8px_8px_0px_0px_#0A0F14] relative overflow-hidden">
          <!-- The fill uses a striped brutalist pattern -->
          <div id="loading-bar-fill" class="h-full w-0 bg-[#4A9EFF] border-r-4 border-[#0A0F14] transition-all duration-100 ease-out relative overflow-hidden">
            <!-- Animated Stripes inside the bar -->
            <div class="absolute inset-0 bg-[linear-gradient(45deg,rgba(0,0,0,0.15)_25%,transparent_25%,transparent_50%,rgba(0,0,0,0.15)_50%,rgba(0,0,0,0.15)_75%,transparent_75%,transparent)] bg-[size:40px_40px] animate-[progress-stripes_1s_linear_infinite]"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- Custom Neo-Brutalist Cursor Follower -->
    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <!-- Entire Website Main Wrapper Container -->
    <!-- Removed initial scale and opacity classes; GSAP will handle the initial state -->
    <div id="main-wrapper" class="w-full origin-center pointer-events-none opacity-0 invisible">
      <slot />
    </div>
    
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Preloader Massive Bar
      const preloader = document.getElementById('preloader');
      const preloaderContent = document.getElementById('preloader-content');
      const loadingBarFill = document.getElementById('loading-bar-fill');
      const loadingPercent = document.getElementById('loading-percent');
      const loadingStatusText = document.getElementById('loading-status-text');
      const mainWrapper = document.getElementById('main-wrapper');

      if (preloader && loadingBarFill && loadingPercent && preloaderContent && mainWrapper) {
        let progress = 0;

        // Mechanical tick sound for percentage updates
        function playTickAudio() {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(800, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.02);
            gain.gain.setValueAtTime(0.05, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.02);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.02);
          } catch (e) {}
        }

        const messages = [
          "INITIALIZING ASSETS...",
          "LOADING NEURAL NETWORKS...",
          "RENDERING 3D GEOMETRY...",
          "CALIBRATING BRUTALISM...",
          "SYSTEM READY."
        ];

        const loadInterval = setInterval(() => {
          // Progress increments in small random chunks
          progress += Math.floor(Math.random() * 4) + 1;
          if (progress > 100) progress = 100;

          loadingBarFill.style.width = `${progress}%`;
          loadingPercent.innerText = `${progress}`;

          // Play a small tick sound every few percent
          if (progress % 3 === 0 && progress < 100) {
            playTickAudio();
          }

          // Update status text based on progress
          if (progress < 25) loadingStatusText.innerText = messages[0];
          else if (progress < 50) {
            loadingStatusText.innerText = messages[1];
            loadingBarFill.style.backgroundColor = '#FF6B22'; // Orange
          }
          else if (progress < 75) {
            loadingStatusText.innerText = messages[2];
            loadingBarFill.style.backgroundColor = '#FFD83D'; // Yellow
          }
          else if (progress < 95) {
            loadingStatusText.innerText = messages[3];
            loadingBarFill.style.backgroundColor = '#DCC5FF'; // Purple
          }
          else {
            loadingStatusText.innerText = messages[4];
            loadingBarFill.style.backgroundColor = '#54D69A'; // Green
          }

          if (progress >= 100) {
            clearInterval(loadInterval);

            // CRISP ZOOM OUT & REVEAL (Zero Blur)
            const tl = gsap.timeline();

            // 1. Preloader text & bar zoom in slightly and fade out
            tl.to(preloaderContent, {
              scale: 1.1,
              opacity: 0,
              duration: 0.3,
              ease: 'power2.in'
            })
            // 2. Preloader background slides up or fades out
            .to(preloader, {
              yPercent: -100,
              duration: 0.5,
              ease: 'power4.inOut',
              onComplete: () => {
                preloader.style.display = 'none';
                mainWrapper.classList.remove('pointer-events-none');
              }
            }, '-=0.1')

            // 3. WEBSITE ZOOMS OUT FROM ALL SIDES CRISPLY
            // Start at scale 1.15, zoom down to 1.0
            .fromTo(mainWrapper, 
              { scale: 1.15, opacity: 0, autoAlpha: 0 },
              {
                scale: 1.0,
                opacity: 1,
                autoAlpha: 1,
                duration: 0.8,
                ease: 'power3.out'
              },
              '-=0.4'
            );
          }
        }, 40);
      }

      // Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Custom Neo-Brutalist Cursor Dynamics
      const cursor = document.getElementById('cursor');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out'
          });
        });

        // Hover expansions on interactive elements
        document.querySelectorAll('a, button, [role="button"], .brutal-shadow-hover').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '36px';
            cursor.style.height = '36px';
            cursor.style.backgroundColor = '#FF6B22';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = '#FFD83D';
          });
        });
      }

      // GSAP Left-to-Right Section Sweep Line Animation on Scroll Entrance
      const sections = document.querySelectorAll('section');
      sections.forEach((section) => {
        const sweepLine = document.createElement('div');
        sweepLine.className = 'section-sweep-line';
        section.appendChild(sweepLine);

        gsap.fromTo(sweepLine, 
          { width: '0%' },
          {
            width: '100%',
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: section,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      });
    </script>
  </body>
</html>
