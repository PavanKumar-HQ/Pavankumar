---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience", 
  description = "Developer, Entrepreneur, Technologist, Community Builder. Personal archive, interactive magazine, and project showcase." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pavan Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F3F1EB] text-[#0A0F14] selection:bg-[#FFD83D] selection:text-[#0A0F14] relative overflow-x-hidden">
    
    <!-- Neo-Brutalist 5-Key Mechanical Boot Sequence Preloader -->
    <div id="preloader" class="fixed inset-0 z-[9999] bg-[#F3F1EB] bg-grid-pattern flex flex-col items-center justify-center p-6 select-none overflow-hidden">
      
      <!-- Floating Decorative Corner Badges -->
      <div class="absolute top-8 left-8 hidden sm:flex items-center gap-2 px-3 py-1 bg-[#FFD83D] text-[#0A0F14] font-mono-tech text-xs font-bold border-2 border-[#0A0F14] shadow-[3px_3px_0px_0px_#0A0F14] -rotate-3">
        ★ BENGALURU, INDIA
      </div>
      <div class="absolute top-8 right-8 hidden sm:flex items-center gap-2 px-3 py-1 bg-[#4A9EFF] text-white font-mono-tech text-xs font-bold border-2 border-[#0A0F14] shadow-[3px_3px_0px_0px_#0A0F14] rotate-3">
        SYSTEM BOOT 2026
      </div>

      <!-- Preloader Central Mechanical Terminal Card -->
      <div id="preloader-card" class="bg-white border-4 border-[#0A0F14] shadow-[12px_12px_0px_0px_#0A0F14] p-8 sm:p-10 max-w-lg w-full flex flex-col items-center gap-8 rounded-3xl relative z-10">
        
        <!-- Header Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#0A0F14] text-[#FFD83D] font-mono-tech text-xs font-bold uppercase border-2 border-[#0A0F14] shadow-[3px_3px_0px_0px_#FF6B22]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B22] animate-ping"></span>
          <span id="preloader-title-tag">ENGAGING MECHANICAL SWITCHES...</span>
        </div>

        <!-- 5-Key Mechanical Switch Rack (P-A-V-A-N) -->
        <div class="flex items-center justify-center gap-3 sm:gap-4 py-2 w-full">
          <!-- Key 1: P -->
          <div id="key-loader-P" class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center transition-all duration-200">
            <div class="absolute inset-0 bg-[#0A0F14] rounded-xl translate-x-2 translate-y-2"></div>
            <div class="key-body absolute inset-0 bg-[#F3F1EB] border-3 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-y-1 transition-all duration-200">
              <span class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14]">P</span>
            </div>
          </div>

          <!-- Key 2: A -->
          <div id="key-loader-A1" class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center transition-all duration-200">
            <div class="absolute inset-0 bg-[#0A0F14] rounded-xl translate-x-2 translate-y-2"></div>
            <div class="key-body absolute inset-0 bg-[#F3F1EB] border-3 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-y-1 transition-all duration-200">
              <span class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14]">A</span>
            </div>
          </div>

          <!-- Key 3: V -->
          <div id="key-loader-V" class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center transition-all duration-200">
            <div class="absolute inset-0 bg-[#0A0F14] rounded-xl translate-x-2 translate-y-2"></div>
            <div class="key-body absolute inset-0 bg-[#F3F1EB] border-3 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-y-1 transition-all duration-200">
              <span class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14]">V</span>
            </div>
          </div>

          <!-- Key 4: A -->
          <div id="key-loader-A2" class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center transition-all duration-200">
            <div class="absolute inset-0 bg-[#0A0F14] rounded-xl translate-x-2 translate-y-2"></div>
            <div class="key-body absolute inset-0 bg-[#F3F1EB] border-3 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-y-1 transition-all duration-200">
              <span class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14]">A</span>
            </div>
          </div>

          <!-- Key 5: N -->
          <div id="key-loader-N" class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center transition-all duration-200">
            <div class="absolute inset-0 bg-[#0A0F14] rounded-xl translate-x-2 translate-y-2"></div>
            <div class="key-body absolute inset-0 bg-[#F3F1EB] border-3 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-y-1 transition-all duration-200">
              <span class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14]">N</span>
            </div>
          </div>
        </div>

        <!-- Segmented Progress Bar & Numerical Counter -->
        <div class="w-full space-y-3">
          <div class="w-full h-7 bg-[#F3F1EB] border-4 border-[#0A0F14] p-1 rounded-xl flex items-center shadow-[4px_4px_0px_0px_#0A0F14] relative overflow-hidden">
            <div id="loading-bar-fill" class="h-full w-0 bg-gradient-to-r from-[#FF6B22] via-[#4A9EFF] to-[#54D69A] border-r-3 border-[#0A0F14] rounded-lg transition-all duration-75 ease-out"></div>
          </div>

          <div class="flex items-center justify-between font-mono-tech font-black text-xs sm:text-sm text-[#0A0F14]">
            <span id="loading-status-text">BOOT SEQUENCE 0%</span>
            <span id="loading-percent" class="px-2.5 py-1 bg-[#FFD83D] text-[#0A0F14] border-2 border-[#0A0F14] rounded-md shadow-[2px_2px_0px_0px_#0A0F14]">0%</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Custom Neo-Brutalist Cursor Follower -->
    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <!-- Entire Website Main Wrapper Container -->
    <div id="main-wrapper" class="w-full origin-center scale-90 opacity-0 pointer-events-none">
      <slot />
    </div>
    
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Preloader 5-Key Mechanical Switch Boot Sequence
      const preloader = document.getElementById('preloader');
      const preloaderCard = document.getElementById('preloader-card');
      const loadingBarFill = document.getElementById('loading-bar-fill');
      const loadingPercent = document.getElementById('loading-percent');
      const loadingStatusText = document.getElementById('loading-status-text');
      const mainWrapper = document.getElementById('main-wrapper');

      // Keycap Element References
      const keyP = document.querySelector('#key-loader-P .key-body');
      const keyA1 = document.querySelector('#key-loader-A1 .key-body');
      const keyV = document.querySelector('#key-loader-V .key-body');
      const keyA2 = document.querySelector('#key-loader-A2 .key-body');
      const keyN = document.querySelector('#key-loader-N .key-body');

      if (preloader && loadingBarFill && loadingPercent && preloaderCard && mainWrapper) {
        let progress = 0;

        // Mechanical key switch audio pop
        function playKeyDepressAudio(freq = 600) {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + 0.04);
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.04);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.04);
          } catch (e) {}
        }

        function depressKey(el: Element | null, bgClass: string, freq: number) {
          if (!el) return;
          el.classList.remove('bg-[#F3F1EB]', '-translate-y-1');
          el.classList.add(bgClass, 'translate-y-1');
          playKeyDepressAudio(freq);
        }

        let pDepressed = false;
        let a1Depressed = false;
        let vDepressed = false;
        let a2Depressed = false;
        let nDepressed = false;

        const loadInterval = setInterval(() => {
          progress += Math.floor(Math.random() * 3) + 1;
          if (progress > 100) progress = 100;

          loadingBarFill.style.width = `${progress}%`;
          loadingPercent.innerText = `${progress}%`;
          loadingStatusText.innerText = `BOOT SEQUENCE ${progress}%`;

          // Step 1: P at 20%
          if (progress >= 20 && !pDepressed) {
            pDepressed = true;
            depressKey(keyP, 'bg-[#FF6B22]', 520);
          }
          // Step 2: A1 at 40%
          if (progress >= 40 && !a1Depressed) {
            a1Depressed = true;
            depressKey(keyA1, 'bg-[#4A9EFF]', 600);
          }
          // Step 3: V at 60%
          if (progress >= 60 && !vDepressed) {
            vDepressed = true;
            depressKey(keyV, 'bg-[#54D69A]', 680);
          }
          // Step 4: A2 at 80%
          if (progress >= 80 && !a2Depressed) {
            a2Depressed = true;
            depressKey(keyA2, 'bg-[#FFD83D]', 740);
          }
          // Step 5: N at 100%
          if (progress >= 100 && !nDepressed) {
            nDepressed = true;
            depressKey(keyN, 'bg-[#DCC5FF]', 820);
          }

          if (progress >= 100) {
            clearInterval(loadInterval);

            // CRISP ZOOM IN & POP REVEAL (Zero Blur!)
            const tl = gsap.timeline();

            // 1. Preloader Card Squeezes down slightly (anticipation)
            tl.to(preloaderCard, {
              scale: 0.9,
              duration: 0.15,
              ease: 'power2.in'
            })
            // 2. Preloader Card ZOOMS IN RAPIDLY & POPS OUT
            .to(preloaderCard, {
              scale: 1.35,
              opacity: 0,
              duration: 0.28,
              ease: 'back.in(2)'
            })
            // 3. Preloader Overlay Fades Out
            .to(preloader, {
              opacity: 0,
              duration: 0.25,
              onComplete: () => {
                preloader.style.display = 'none';
                mainWrapper.classList.remove('pointer-events-none');
              }
            }, '-=0.15')

            // 4. WEBSITE ZOOMS IN AND POPS CRISPLY (scale 0.9 -> scale 1.05 -> scale 1.0)
            .fromTo(mainWrapper, 
              { scale: 0.88, opacity: 0 },
              {
                scale: 1.0,
                opacity: 1,
                duration: 0.75,
                ease: 'back.out(1.8)'
              },
              '-=0.2'
            );
          }
        }, 32);
      }

      // Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Custom Neo-Brutalist Cursor Dynamics
      const cursor = document.getElementById('cursor');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out'
          });
        });

        // Hover expansions on interactive elements
        document.querySelectorAll('a, button, [role="button"], .brutal-shadow-hover').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '36px';
            cursor.style.height = '36px';
            cursor.style.backgroundColor = '#FF6B22';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = '#FFD83D';
          });
        });
      }

      // GSAP Left-to-Right Section Sweep Line Animation on Scroll Entrance
      const sections = document.querySelectorAll('section');
      sections.forEach((section) => {
        const sweepLine = document.createElement('div');
        sweepLine.className = 'section-sweep-line';
        section.appendChild(sweepLine);

        gsap.fromTo(sweepLine, 
          { width: '0%' },
          {
            width: '100%',
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: section,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      });
    </script>
  </body>
</html>
