---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "PAVAN KUMAR / WORLD — Personal Digital Archive & Interactive Experience", 
  description = "Developer, Entrepreneur, Technologist, Community Builder. Personal archive, interactive magazine, and project showcase." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pavan Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F3F1EB] text-[#0A0F14] selection:bg-[#FFD83D] selection:text-[#0A0F14] relative">
    
    <!-- Neo-Brutalist Kinetic Preloader Screen -->
    <div id="preloader" class="fixed inset-0 z-[9999] bg-[#F3F1EB] bg-grid-pattern flex flex-col items-center justify-center p-6 select-none overflow-hidden">
      
      <!-- Preloader Central Card with Kinetic Breathing Zoom -->
      <div id="preloader-card" class="bg-white border-4 border-[#0A0F14] shadow-[8px_8px_0px_0px_#0A0F14] p-8 max-w-md w-full flex flex-col items-center gap-6 rounded-3xl relative overflow-hidden">
        
        <!-- Status Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#FFD83D] text-[#0A0F14] font-mono-tech text-xs font-bold uppercase brutal-border-thick rotate-1 shadow-[3px_3px_0px_0px_#0A0F14]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B22] animate-ping"></span>
          <span>INITIALIZING ARCHIVE...</span>
        </div>

        <!-- Branding Header -->
        <div class="text-center">
          <h2 class="font-heading font-black text-4xl sm:text-5xl uppercase tracking-tighter text-[#0A0F14]">
            PAVAN KUMAR
          </h2>
          <p class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest mt-1">
            DIGITAL PORTFOLIO 2026
          </p>
        </div>

        <!-- Neo-Brutalist Loading Bar Container -->
        <div class="w-full space-y-3">
          <div class="w-full h-8 bg-[#F3F1EB] border-4 border-[#0A0F14] p-1 rounded-xl flex items-center shadow-[4px_4px_0px_0px_#0A0F14] relative overflow-hidden">
            <!-- Progress Fill Bar with Dynamic Neo-Brutalist Gradient -->
            <div id="loading-bar-fill" class="h-full w-0 bg-gradient-to-r from-[#FF6B22] via-[#FFD83D] to-[#54D69A] border-r-3 border-[#0A0F14] rounded-lg transition-all duration-75 ease-out"></div>
          </div>

          <!-- Progress Percentage Counter & Status -->
          <div class="flex items-center justify-between font-mono-tech font-black text-xs sm:text-sm text-[#0A0F14]">
            <span id="loading-status-text">LOADING ASSETS</span>
            <span id="loading-percent" class="px-2 py-0.5 bg-[#4A9EFF] text-white border-2 border-[#0A0F14] rounded-md shadow-[2px_2px_0px_0px_#0A0F14]">0%</span>
          </div>
        </div>

        <!-- Micro-Brutalist Decorative Keycaps Array -->
        <div class="flex items-center justify-center gap-2 pt-2 border-t-2 border-[#0A0F14]/10 w-full">
          <div class="w-7 h-7 bg-[#FF6B22] border-2 border-[#0A0F14] rounded-lg shadow-[2px_2px_0px_0px_#0A0F14] flex items-center justify-center font-black text-xs">P</div>
          <div class="w-7 h-7 bg-[#4A9EFF] border-2 border-[#0A0F14] rounded-lg shadow-[2px_2px_0px_0px_#0A0F14] flex items-center justify-center font-black text-xs text-white">A</div>
          <div class="w-7 h-7 bg-[#54D69A] border-2 border-[#0A0F14] rounded-lg shadow-[2px_2px_0px_0px_#0A0F14] flex items-center justify-center font-black text-xs">V</div>
          <div class="w-7 h-7 bg-[#FFD83D] border-2 border-[#0A0F14] rounded-lg shadow-[2px_2px_0px_0px_#0A0F14] flex items-center justify-center font-black text-xs">A</div>
          <div class="w-7 h-7 bg-[#DCC5FF] border-2 border-[#0A0F14] rounded-lg shadow-[2px_2px_0px_0px_#0A0F14] flex items-center justify-center font-black text-xs">N</div>
        </div>

      </div>

    </div>

    <!-- Custom Neo-Brutalist Cursor Follower -->
    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <slot />
    
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Preloader Loading Simulation & Kinetic Zoom Exit Sequence
      const preloader = document.getElementById('preloader');
      const preloaderCard = document.getElementById('preloader-card');
      const loadingBarFill = document.getElementById('loading-bar-fill');
      const loadingPercent = document.getElementById('loading-percent');
      const loadingStatusText = document.getElementById('loading-status-text');

      if (preloader && loadingBarFill && loadingPercent && preloaderCard) {
        let progress = 0;
        const statusPhrases = [
          "COMPILING MODULES",
          "MOUNTING 3D KEYBOARD",
          "RENDERING ARCHIVE",
          "READY!"
        ];

        // Synthesize subtle progress audio ticks
        function playProgressTick() {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(800, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.02);
            gain.gain.setValueAtTime(0.12, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.02);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.02);
          } catch (e) {}
        }

        const loadInterval = setInterval(() => {
          progress += Math.floor(Math.random() * 8) + 4;
          if (progress > 100) progress = 100;

          loadingBarFill.style.width = `${progress}%`;
          loadingPercent.innerText = `${progress}%`;

          // Update status phrase
          if (progress < 30) {
            loadingStatusText.innerText = statusPhrases[0];
          } else if (progress < 65) {
            loadingStatusText.innerText = statusPhrases[1];
          } else if (progress < 95) {
            loadingStatusText.innerText = statusPhrases[2];
          } else {
            loadingStatusText.innerText = statusPhrases[3];
          }

          if (progress % 20 === 0) {
            playProgressTick();
          }

          if (progress >= 100) {
            clearInterval(loadInterval);

            // Kinetic Zoom-In / Zoom-Out Exit Sequence
            const tl = gsap.timeline();

            // Step 1: Micro Zoom Out Elastic Dip
            tl.to(preloaderCard, {
              scale: 0.92,
              duration: 0.25,
              ease: 'back.out(2)'
            })
            // Step 2: Explosive Kinetic Zoom-In Burst
            .to(preloaderCard, {
              scale: 1.35,
              opacity: 0,
              duration: 0.35,
              ease: 'power3.in'
            })
            // Step 3: Fade & Zoom Out Preloader Background Overlay
            .to(preloader, {
              scale: 1.15,
              opacity: 0,
              duration: 0.4,
              ease: 'power2.inOut',
              onComplete: () => {
                preloader.style.display = 'none';
              }
            }, '-=0.2');
          }
        }, 35);
      }

      // Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Custom Neo-Brutalist Cursor Dynamics
      const cursor = document.getElementById('cursor');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.15,
            ease: 'power2.out'
          });
        });

        // Hover expansions on interactive elements
        document.querySelectorAll('a, button, [role="button"], .brutal-shadow-hover').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '36px';
            cursor.style.height = '36px';
            cursor.style.backgroundColor = '#FF6B22';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = '#FFD83D';
          });
        });
      }

      // GSAP Left-to-Right Section Sweep Line Animation on Scroll Entrance
      const sections = document.querySelectorAll('section');
      sections.forEach((section) => {
        const sweepLine = document.createElement('div');
        sweepLine.className = 'section-sweep-line';
        section.appendChild(sweepLine);

        gsap.fromTo(sweepLine, 
          { width: '0%' },
          {
            width: '100%',
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: section,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      });
    </script>
  </body>
</html>
