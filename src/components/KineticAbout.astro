<section id="about" class="w-full min-h-[80vh] py-24 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#0A0F14] text-[#F3F1EB] relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FF6B22] text-[#0A0F14] font-mono-tech text-xs font-bold mb-8 brutal-border">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [02] THE PHILOSOPHY
