<section id="about" class="py-24 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#F3F1EB] relative">
  
  <div class="max-w-7xl mx-auto">
    <!-- Clean Section Header -->

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Editorial Narrative Header -->
      <div class="lg:col-span-6 space-y-6">
        <h2 class="font-heading font-black text-4xl sm:text-6xl uppercase leading-tight tracking-tight">
          WHO IS PAVAN KUMAR?
        </h2>
        <p class="font-sans text-base sm:text-lg text-[#0A0F14]/80 leading-relaxed">
          I am a builder, technologist, and entrepreneur. I don't build software just for the sake of code — I build systems to solve meaningful problems, scale businesses, and empower communities.
        </p>
        <p class="font-sans text-sm sm:text-base text-[#0A0F14]/70 leading-relaxed">
          From co-founding <strong>Brandex</strong> to empowering 200+ students through <strong>Geniusphere</strong>, my goal is to bridge the gap between abstract technology and real-world execution.
        </p>
      </div>

      <!-- Right Modern Interactive Focus Bar Tracks -->
      <div class="lg:col-span-6 space-y-6 font-mono-tech border-l-4 border-[#0A0F14] pl-8 py-2">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FF6B22]"></span>
          <span class="text-xs font-bold text-[#0A0F14] uppercase tracking-widest">EXPLORATION TRACKS</span>
        </div>
        
        <div class="space-y-3 font-heading font-black text-xl sm:text-2xl uppercase tracking-tight text-[#0A0F14]">
          <div class="p-3.5 bg-white brutal-border border-[#0A0F14] hover:bg-[#4A9EFF] hover:text-white transition-all duration-200 flex items-center justify-between group cursor-default">
            <span>ARTIFICIAL INTELLIGENCE & ML</span>
            <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
          </div>

          <div class="p-3.5 bg-white brutal-border border-[#0A0F14] hover:bg-[#54D69A] hover:text-[#0A0F14] transition-all duration-200 flex items-center justify-between group cursor-default">
            <span>AUTOMATION & AI TOOLS</span>
            <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
          </div>

          <div class="p-3.5 bg-white brutal-border border-[#0A0F14] hover:bg-[#FF6B22] hover:text-white transition-all duration-200 flex items-center justify-between group cursor-default">
            <span>CYBERSECURITY ESSENTIALS</span>
            <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
          </div>

          <div class="p-3.5 bg-white brutal-border border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-all duration-200 flex items-center justify-between group cursor-default">
            <span>DIGITAL FINANCE & TECH</span>
            <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
          </div>

          <div class="p-3.5 bg-white brutal-border border-[#0A0F14] hover:bg-[#DCC5FF] hover:text-[#0A0F14] transition-all duration-200 flex items-center justify-between group cursor-default">
            <span>QUANTUM COMPUTING</span>
            <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
          </div>
        </div>

        <p class="font-sans text-xs text-[#0A0F14]/70 leading-relaxed pt-2">
          Focusing on first principles engineering, end-to-end automation, and bridging abstract technical concepts with practical real-world execution.
        </p>
      </div>

    </div>

    <!-- Core Personal Manifesto Banner -->
    <div class="mt-16 p-8 sm:p-12 bg-white text-[#0A0F14] brutal-border-thick brutal-shadow-xl relative overflow-hidden">
      <blockquote class="font-heading font-black text-2xl sm:text-4xl leading-tight uppercase text-balance">
        "I build technology, businesses, communities, and experiments around problems I find genuinely interesting."
      </blockquote>
      <div class="mt-6 font-mono-tech text-xs text-[#0A0F14]/60 font-bold border-t-2 border-[#0A0F14]/10 pt-4">
        — PAVAN KUMAR, ARCHITECT & BUILDER
      </div>
    </div>

  </div>
</section>
