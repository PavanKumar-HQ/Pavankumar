        <div class="text-xl font-black mt-1">BUSINESS</div>
      </div>
      <div class="p-6 bg-[#54D69A] text-[#0A0F14] brutal-border-thick font-bold brutal-shadow-hover transition-all cursor-pointer">
        <div class="text-[10px] text-[#0A0F14]/50">03.IMPACT</div>
        <div class="text-xl font-black mt-1">EDUCATION</div>
      </div>
      <div class="p-6 bg-[#DCC5FF] text-[#0A0F14] brutal-border-thick font-bold brutal-shadow-hover transition-all cursor-pointer">
