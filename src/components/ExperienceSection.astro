---
---

<section id="experience" class="w-full bg-[#F3F1EB] border-b-2 border-[#0A0F14] px-6 sm:px-12 lg:px-20 py-20">

  <!-- Section Header -->
  <div class="max-w-3xl mb-12 space-y-2">
    <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/40 uppercase tracking-[0.2em]">03 / PROFESSIONAL WORK</div>
    <h2 class="font-heading font-black text-5xl sm:text-7xl uppercase leading-none text-[#0A0F14]">Experience</h2>
  </div>

  <!-- LinkedIn-style Timeline -->
  <div class="max-w-3xl space-y-0">

    <!-- ─── Entry 1: Sanna Innovations ─── -->
    <div class="flex gap-6">
      <!-- Left: logo + vertical line -->
      <div class="flex flex-col items-center">
        <!-- Company Icon -->
        <div class="w-14 h-14 bg-[#0A0F14] border-2 border-[#0A0F14] flex items-center justify-center shrink-0 brutal-shadow-lg">
          <span class="font-heading font-black text-xl text-[#FFD83D]">SI</span>
        </div>
        <!-- Vertical connector -->
        <div class="w-0.5 bg-[#0A0F14]/20 flex-1 my-2"></div>
      </div>

      <!-- Right: content -->
      <div class="pb-12 flex-1">
        <!-- Role -->
        <div class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14] uppercase leading-tight">
          AI Research Intern
        </div>
        <!-- Company + type -->
        <div class="flex flex-wrap items-center gap-2 mt-1 font-mono-tech text-sm font-bold text-[#0A0F14]">
          <span>Sanna Innovations</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span class="text-[#0A0F14]/60 font-normal">Internship</span>
        </div>
        <!-- Date + Location -->
        <div class="flex flex-wrap items-center gap-2 mt-1 font-mono-tech text-xs text-[#0A0F14]/50">
          <span>Jul 2025 – Oct 2025</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span>4 months</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span>Bengaluru, Karnataka</span>
        </div>

        <!-- Card -->
        <div class="mt-5 bg-white border-2 border-[#0A0F14] brutal-shadow-lg p-6 space-y-5">
          <!-- Description -->
          <p class="font-sans text-sm sm:text-base text-[#0A0F14]/80 leading-relaxed">
            Worked on client outreach through cold calls and emails, and explored how AI tools enhance business communication and client engagement.
          </p>

          <!-- What I did list -->
          <ul class="space-y-2">
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#4A9EFF] shrink-0"></span>
              Client outreach via cold calls and email campaigns
            </li>
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#4A9EFF] shrink-0"></span>
              Explored AI tools in business communication workflows
            </li>
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#4A9EFF] shrink-0"></span>
              Applied AI to improve client engagement strategies
            </li>
          </ul>

          <!-- Skills / Tags -->
          <div class="pt-4 border-t-2 border-[#0A0F14]/10 flex flex-wrap gap-2">
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#F3F1EB] border-2 border-[#0A0F14]/20 text-[#0A0F14]">Client Outreach</span>
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#4A9EFF]/10 border-2 border-[#4A9EFF]/30 text-[#1D6EFF]">AI Tools</span>
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#FFD83D]/20 border-2 border-[#FFD83D] text-[#0A0F14]">Business Communication</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Entry 2: Epic Minds ─── -->
    <div class="flex gap-6">
      <!-- Left: logo + no line (last item) -->
      <div class="flex flex-col items-center">
        <div class="w-14 h-14 bg-[#54D69A] border-2 border-[#0A0F14] flex items-center justify-center shrink-0 brutal-shadow-lg">
          <span class="font-heading font-black text-xl text-[#0A0F14]">EM</span>
        </div>
      </div>

      <!-- Right: content -->
      <div class="pb-4 flex-1">
        <div class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14] uppercase leading-tight">
          AIML Intern
        </div>
        <div class="flex flex-wrap items-center gap-2 mt-1 font-mono-tech text-sm font-bold text-[#0A0F14]">
          <span>Epic Minds</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span class="text-[#0A0F14]/60 font-normal">Internship</span>
        </div>
        <div class="flex flex-wrap items-center gap-2 mt-1 font-mono-tech text-xs text-[#0A0F14]/50">
          <span>Nov 2025 – Dec 2025</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span>2 months</span>
          <span class="text-[#0A0F14]/30">·</span>
          <span>Bengaluru, Karnataka</span>
        </div>

        <div class="mt-5 bg-white border-2 border-[#0A0F14] brutal-shadow-lg p-6 space-y-5">
          <p class="font-sans text-sm sm:text-base text-[#0A0F14]/80 leading-relaxed">
            Contributed to the project lifecycle by preparing design documents, organizing technical information, and supporting the development team with AIML-related tasks.
          </p>

          <ul class="space-y-2">
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#54D69A] shrink-0"></span>
              Prepared and maintained design documents and technical specs
            </li>
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#54D69A] shrink-0"></span>
              Organized technical information across the project lifecycle
            </li>
            <li class="flex items-start gap-2 font-sans text-sm text-[#0A0F14]">
              <span class="mt-1.5 w-1.5 h-1.5 bg-[#54D69A] shrink-0"></span>
              Supported development team with AIML-related tasks
            </li>
          </ul>

          <div class="pt-4 border-t-2 border-[#0A0F14]/10 flex flex-wrap gap-2">
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#F3F1EB] border-2 border-[#0A0F14]/20 text-[#0A0F14]">Documentation</span>
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#54D69A]/20 border-2 border-[#54D69A] text-[#0A8A4A]">AIML</span>
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#F3F1EB] border-2 border-[#0A0F14]/20 text-[#0A0F14]">Technical Writing</span>
            <span class="font-mono-tech text-[10px] font-bold uppercase px-2 py-1 bg-[#F3F1EB] border-2 border-[#0A0F14]/20 text-[#0A0F14]">Dev Support</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom CTA -->
  <div class="max-w-3xl mt-16 pt-10 border-t-2 border-[#0A0F14] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="font-heading font-black text-2xl sm:text-3xl uppercase text-[#0A0F14] leading-tight">
      From projects<br><span class="text-[#FF6B22]">to building my own.</span>
    </div>
    <a href="#geniusphere" class="flex items-center gap-2 bg-[#0A0F14] text-[#FFD83D] px-6 py-3 font-heading font-black text-lg uppercase border-2 border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-colors group brutal-shadow-lg shrink-0">
      GENIUSPHERE <span class="group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  </div>

</section>
