---
---

<section id="experience" class="w-full bg-[#F3F1EB] border-b-2 border-[#0A0F14]">

  <!-- ══════════════════════════════════════════ -->
  <!-- SECTION HEADER                            -->
  <!-- ══════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] border-b-2 border-[#0A0F14]">
    <div class="px-8 sm:px-16 py-12 border-r-0 lg:border-r-2 border-[#0A0F14]">
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/40 uppercase tracking-[0.2em] mb-4">03 / PROFESSIONAL WORK</div>
      <h2 class="font-heading font-black text-[clamp(4rem,12vw,9rem)] leading-none uppercase text-[#0A0F14]">WORK</h2>
    </div>
    <div class="px-8 sm:px-12 py-12 flex flex-col justify-end gap-2">
      <div class="font-heading font-black text-8xl sm:text-[9rem] text-[#FFD83D] leading-none drop-shadow-[3px_3px_0px_#0A0F14]">02</div>
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest">INTERNSHIPS<br>2025</div>
    </div>
  </div>

  <!-- Timeline bar -->
  <div class="flex flex-wrap gap-0 divide-x-2 divide-[#0A0F14] border-b-2 border-[#0A0F14] font-mono-tech text-xs font-bold uppercase tracking-widest">
    <div class="px-6 py-3 text-[#0A0F14]/40">2025</div>
    <div class="px-6 py-3 flex items-center gap-3">
      <span class="w-2 h-2 bg-[#4A9EFF] inline-block"></span>
      <span>JUL → OCT</span>
      <span class="text-[#4A9EFF]">SANNA INNOVATIONS</span>
    </div>
    <div class="px-6 py-3 flex items-center gap-3">
      <span class="w-2 h-2 bg-[#54D69A] inline-block"></span>
      <span>NOV → DEC</span>
      <span class="text-[#54D69A]">EPIC MINDS</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════ -->
  <!-- INTERNSHIP 01: Sanna Innovations          -->
  <!-- ══════════════════════════════════════════ -->

  <!-- Dark header band -->
  <div class="bg-[#0A0F14] border-b-2 border-[#0A0F14] px-8 sm:px-16 py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
    <div class="flex items-end gap-6 sm:gap-10">
      <span class="font-heading font-black text-[6rem] sm:text-[8rem] text-[#FFD83D]/20 leading-none select-none">01</span>
      <div>
        <h3 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase leading-none text-[#FFD83D]">
          AI RESEARCH<br>INTERN
        </h3>
        <div class="mt-2 inline-flex items-center gap-2 bg-[#FFD83D] px-3 py-1 font-mono-tech text-xs font-black text-[#0A0F14] uppercase tracking-widest">
          ★ SANNA INNOVATIONS
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 font-mono-tech text-xs font-bold">
      <span class="px-3 py-1.5 border-2 border-[#FFD83D]/30 text-[#FFD83D]">JUL 2025 — OCT 2025</span>
      <span class="px-3 py-1.5 border-2 border-white/20 text-white/70">BENGALURU, KA</span>
    </div>
  </div>

  <!-- Content: description + workflow -->
  <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] border-b-2 border-[#0A0F14] divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#0A0F14]">

    <!-- Left: description + marquee -->
    <div class="px-8 sm:px-16 py-12 space-y-8">
      <p class="font-sans text-lg sm:text-xl text-[#0A0F14] leading-relaxed max-w-xl">
        Worked on client outreach through cold calls and emails, exploring how AI tools enhance business communication and client engagement.
      </p>
      <!-- Rolling text -->
      <div class="overflow-hidden border-t-2 border-[#0A0F14] pt-8">
        <div class="ticker-track font-heading font-black text-3xl sm:text-4xl uppercase text-[#0A0F14]">
          <div class="flex shrink-0 items-center gap-6">
            <span>OUTREACH</span><span class="text-[#4A9EFF]">→</span>
            <span>COMMUNICATION</span><span class="text-[#4A9EFF]">→</span>
            <span>ENGAGEMENT</span><span class="text-[#4A9EFF]">→</span>
          </div>
          <div class="flex shrink-0 items-center gap-6" aria-hidden="true">
            <span>OUTREACH</span><span class="text-[#4A9EFF]">→</span>
            <span>COMMUNICATION</span><span class="text-[#4A9EFF]">→</span>
            <span>ENGAGEMENT</span><span class="text-[#4A9EFF]">→</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: process flow -->
    <div class="px-8 sm:px-10 py-12 bg-[#F3F1EB] flex flex-col gap-0">
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/40 uppercase tracking-widest mb-8">WHAT I WORKED AROUND</div>
      <div class="flex flex-col gap-0">
        <div class="py-5 border-t-2 border-[#0A0F14] flex items-center justify-between group">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">CLIENT OUTREACH</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">01</span>
        </div>
        <div class="py-5 border-t-2 border-[#0A0F14] flex items-center justify-between">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">AI BUSINESS COMMS</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">02</span>
        </div>
        <div class="py-5 border-t-2 border-b-2 border-[#0A0F14] flex items-center justify-between">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">CLIENT ENGAGEMENT</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">03</span>
        </div>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════ -->
  <!-- DIVIDER                                   -->
  <!-- ══════════════════════════════════════════ -->
  <div class="px-8 sm:px-16 py-5 border-b-2 border-[#0A0F14] bg-[#F3F1EB] flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-12">
    <span class="font-mono-tech text-[10px] font-bold text-[#0A0F14]/30 uppercase tracking-[0.2em]">TWO INTERNSHIPS. TWO DIFFERENT WAYS OF WORKING.</span>
    <div class="flex items-center gap-4 font-heading font-black text-lg sm:text-xl uppercase">
      <span class="text-[#4A9EFF]">OUTREACH × AI</span>
      <span class="text-[#0A0F14]/20">——</span>
      <span class="text-[#54D69A]">DOCS × DEV SUPPORT</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════ -->
  <!-- INTERNSHIP 02: Epic Minds                 -->
  <!-- ══════════════════════════════════════════ -->

  <!-- Green header band -->
  <div class="bg-[#54D69A] border-b-2 border-[#0A0F14] px-8 sm:px-16 py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
    <div class="flex items-end gap-6 sm:gap-10">
      <span class="font-heading font-black text-[6rem] sm:text-[8rem] text-[#0A0F14]/10 leading-none select-none">02</span>
      <div>
        <h3 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase leading-none text-[#0A0F14]">
          AIML<br>INTERN
        </h3>
        <div class="mt-2 inline-flex items-center gap-2 bg-[#0A0F14] px-3 py-1 font-mono-tech text-xs font-black text-[#54D69A] uppercase tracking-widest">
          ★ EPIC MINDS
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 font-mono-tech text-xs font-bold">
      <span class="px-3 py-1.5 bg-[#0A0F14] text-[#54D69A]">NOV 2025 — DEC 2025</span>
      <span class="px-3 py-1.5 bg-[#0A0F14] text-white/70">BENGALURU, KA</span>
    </div>
  </div>

  <!-- Content: workflow + description -->
  <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] border-b-2 border-[#0A0F14] divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#0A0F14]">

    <!-- Left: process flow -->
    <div class="px-8 sm:px-10 py-12 flex flex-col gap-0">
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/40 uppercase tracking-widest mb-8">WHAT I CONTRIBUTED TO</div>
      <div class="flex flex-col gap-0">
        <div class="py-5 border-t-2 border-[#0A0F14] flex items-center justify-between">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">DESIGN DOCUMENTS</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">01</span>
        </div>
        <div class="py-5 border-t-2 border-[#0A0F14] flex items-center justify-between">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">TECHNICAL INFO</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">02</span>
        </div>
        <div class="py-5 border-t-2 border-b-2 border-[#0A0F14] flex items-center justify-between">
          <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14]">DEV SUPPORT</span>
          <span class="font-mono-tech text-xs text-[#0A0F14]/30">03</span>
        </div>
      </div>
    </div>

    <!-- Right: description + big words -->
    <div class="px-8 sm:px-16 py-12 space-y-8">
      <p class="font-sans text-lg sm:text-xl text-[#0A0F14] leading-relaxed max-w-xl">
        Contributed to the project lifecycle by preparing design documents, organizing technical information, and supporting the team with development-related tasks.
      </p>
      <div class="border-t-2 border-[#0A0F14] pt-8 flex flex-wrap gap-x-6 gap-y-2 font-heading font-black text-3xl sm:text-4xl uppercase text-[#0A0F14]">
        <span class="hover:text-[#54D69A] transition-colors cursor-default">DOCUMENT.</span>
        <span class="hover:text-[#54D69A] transition-colors cursor-default">ORGANIZE.</span>
        <span class="hover:text-[#54D69A] transition-colors cursor-default">SUPPORT.</span>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════ -->
  <!-- BOTTOM TRANSITION                         -->
  <!-- ══════════════════════════════════════════ -->
  <div class="bg-[#0A0F14] px-8 sm:px-16 py-14 flex flex-col sm:flex-row sm:items-center justify-between gap-8">
    <div class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl uppercase leading-tight text-white">
      FROM WORKING ON PROJECTS<br>
      <span class="text-[#FF6B22]">TO BUILDING MY OWN.</span>
    </div>
    <a href="#geniusphere" class="flex items-center gap-3 bg-[#FFD83D] text-[#0A0F14] px-8 py-4 font-heading font-black text-xl uppercase border-2 border-[#FFD83D] hover:bg-transparent hover:text-[#FFD83D] transition-colors group shrink-0">
      GENIUSPHERE
      <span class="group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  </div>

</section>
