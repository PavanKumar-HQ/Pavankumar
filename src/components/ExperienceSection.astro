---
---

<section id="experience" class="w-full border-b-2 border-[#0A0F14]">

  <!-- ══ Section Header ══ -->
  <div class="bg-[#F3F1EB] border-b-2 border-[#0A0F14] px-8 sm:px-16 py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/50 uppercase tracking-[0.2em] mb-2">03 / PROFESSIONAL WORK</div>
      <h2 class="font-heading font-black text-6xl sm:text-8xl uppercase leading-none text-[#0A0F14]">WORK</h2>
    </div>
    <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/50 uppercase tracking-widest pb-2">2 INTERNSHIPS &nbsp;&middot;&nbsp; 2025</div>
  </div>

  <!-- ══════════════════════════════════════════════ -->
  <!-- ENTRY 01  –  SANNA INNOVATIONS               -->
  <!-- ══════════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] min-h-[320px]">

    <!-- Left: colour block with oversized number -->
    <div class="bg-[#0A0F14] relative flex flex-col justify-between p-8 sm:p-12 overflow-hidden border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0F14]">
      <!-- Giant ghost number -->
      <span class="absolute bottom-0 right-0 font-heading font-black text-[12rem] sm:text-[16rem] leading-none text-white/[0.04] select-none pointer-events-none translate-x-6 translate-y-4">01</span>

      <!-- Content -->
      <div class="relative z-10">
        <div class="font-mono-tech text-[10px] font-bold text-[#FFD83D]/60 uppercase tracking-[0.3em] mb-4">AI RESEARCH</div>
        <h3 class="font-heading font-black text-4xl sm:text-5xl xl:text-6xl leading-[0.9] uppercase text-[#FFD83D]">
          AI<br>RESEARCH<br>INTERN
        </h3>
      </div>

      <div class="relative z-10 flex flex-col gap-3 mt-6">
        <!-- Company name: large + visible -->
        <div class="font-heading font-black text-2xl sm:text-3xl text-[#FFD83D] uppercase leading-none">SANNA INNOVATIONS</div>
        <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold text-white/60 uppercase tracking-wide">
          <span>JUL — OCT 2025</span>
          <span class="text-white/30">|</span>
          <span>4 MONTHS</span>
          <span class="text-white/30">|</span>
          <span>ON-SITE</span>
        </div>
      </div>
    </div>

    <!-- Right: detail area -->
    <div class="bg-[#F3F1EB] flex flex-col justify-between p-8 sm:p-12 border-b-2 border-[#0A0F14]">

      <!-- Description -->
      <p class="font-sans text-base sm:text-lg text-[#0A0F14] leading-relaxed max-w-lg">
        Worked on client outreach through cold calls and emails — exploring how AI tools can make business communication sharper and more human.
      </p>

      <!-- Numbered responsibility rows -->
      <div class="mt-8 flex flex-col divide-y-2 divide-[#0A0F14]/10">
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#4A9EFF] w-6 shrink-0">01</span>
          <span class="font-sans text-sm text-[#0A0F14]">Client outreach via cold calls & targeted email sequences</span>
        </div>
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#4A9EFF] w-6 shrink-0">02</span>
          <span class="font-sans text-sm text-[#0A0F14]">Researched & applied AI tools to sharpen communication workflows</span>
        </div>
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#4A9EFF] w-6 shrink-0">03</span>
          <span class="font-sans text-sm text-[#0A0F14]">Built and refined client engagement strategies using AI-assisted content</span>
        </div>
      </div>

      <!-- Skill tags -->
      <div class="mt-8 flex flex-wrap gap-2">
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 bg-[#4A9EFF] text-white">CLIENT OUTREACH</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 bg-[#FFD83D] text-[#0A0F14] border-2 border-[#0A0F14]">AI TOOLS</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 border-2 border-[#0A0F14] text-[#0A0F14]">COLD CALLING</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 border-2 border-[#0A0F14] text-[#0A0F14]">BIZ COMM</span>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════════ -->
  <!-- ENTRY 02  –  EPIC MINDS                      -->
  <!-- ══════════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-[7fr_5fr]">

    <!-- Left: detail area -->
    <div class="bg-[#F3F1EB] flex flex-col justify-between p-8 sm:p-12 border-b-2 lg:border-b-0 border-r-0 lg:border-r-2 border-[#0A0F14]">

      <p class="font-sans text-base sm:text-lg text-[#0A0F14] leading-relaxed max-w-lg">
        Contributed to the full project lifecycle — writing design documents, organizing technical information, and supporting the dev team wherever AIML tasks arose.
      </p>

      <div class="mt-8 flex flex-col divide-y-2 divide-[#0A0F14]/10">
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#54D69A] w-6 shrink-0">01</span>
          <span class="font-sans text-sm text-[#0A0F14]">Prepared and maintained design documents & technical specs</span>
        </div>
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#54D69A] w-6 shrink-0">02</span>
          <span class="font-sans text-sm text-[#0A0F14]">Organized and structured technical information across the project</span>
        </div>
        <div class="py-3 flex items-center gap-5">
          <span class="font-mono-tech text-[10px] font-bold text-[#54D69A] w-6 shrink-0">03</span>
          <span class="font-sans text-sm text-[#0A0F14]">Supported development team on AIML-related tasks end-to-end</span>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 bg-[#54D69A] text-[#0A0F14] border-2 border-[#0A0F14]">AIML</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 bg-[#0A0F14] text-white">DOCUMENTATION</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 border-2 border-[#0A0F14] text-[#0A0F14]">TECH WRITING</span>
        <span class="font-mono-tech text-[10px] font-bold px-3 py-1 border-2 border-[#0A0F14] text-[#0A0F14]">DEV SUPPORT</span>
      </div>

    </div>

    <!-- Right: colour block -->
    <div class="bg-[#54D69A] relative flex flex-col justify-between p-8 sm:p-12 overflow-hidden border-b-2 border-[#0A0F14]">
      <span class="absolute bottom-0 left-0 font-heading font-black text-[12rem] sm:text-[16rem] leading-none text-[#0A0F14]/[0.06] select-none pointer-events-none -translate-x-6 translate-y-4">02</span>

      <div class="relative z-10">
        <div class="font-mono-tech text-[10px] font-bold text-[#0A0F14]/50 uppercase tracking-[0.3em] mb-4">AIML</div>
        <h3 class="font-heading font-black text-4xl sm:text-5xl xl:text-6xl leading-[0.9] uppercase text-[#0A0F14]">
          AIML<br>INTERN
        </h3>
      </div>

      <div class="relative z-10 flex flex-col gap-3 mt-6">
        <!-- Company name: large + visible -->
        <div class="font-heading font-black text-2xl sm:text-3xl text-[#0A0F14] uppercase leading-none">EPIC MINDS</div>
        <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-wide">
          <span>NOV — DEC 2025</span>
          <span class="text-[#0A0F14]/30">|</span>
          <span>2 MONTHS</span>
          <span class="text-[#0A0F14]/30">|</span>
          <span>ON-SITE</span>
        </div>
      </div>
    </div>

  </div>

  <!-- ══ Bottom CTA strip ══ -->
  <div class="bg-[#FF6B22] border-t-2 border-[#0A0F14] px-8 sm:px-16 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <span class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14] leading-tight">
      From projects → to building my own.
    </span>
    <a href="#geniusphere"
       class="font-heading font-black text-sm uppercase px-6 py-3 bg-[#0A0F14] text-[#FFD83D] border-2 border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-colors flex items-center gap-2 group shrink-0">
      GENIUSPHERE <span class="group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  </div>

</section>
