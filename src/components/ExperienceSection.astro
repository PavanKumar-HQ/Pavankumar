---
---

<section id="experience" class="w-full border-b-3 border-[#0A0F14] bg-[#F3F1EB]">

  <!-- Section Header -->
  <div class="px-6 sm:px-12 lg:px-16 pt-16 pb-10 border-b-2 border-[#0A0F14] flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/50 uppercase tracking-widest mb-3">03 / PROFESSIONAL WORK</div>
      <h2 class="font-heading font-black text-5xl sm:text-7xl uppercase leading-none text-[#0A0F14]">WORK</h2>
    </div>
    <p class="font-sans text-base text-[#0A0F14]/60 max-w-md leading-relaxed">
      A few places where I got to contribute and explore beyond the classroom.
    </p>
  </div>

  <!-- Chronology Strip -->
  <div class="px-6 sm:px-12 lg:px-16 py-6 border-b-2 border-[#0A0F14] flex flex-wrap gap-8 font-mono-tech text-xs font-bold uppercase tracking-widest text-[#0A0F14]/60">
    <span>2025</span>
    <span class="flex items-center gap-2"><span class="bg-[#4A9EFF] text-white px-2 py-0.5">JUL → OCT</span> SANNA INNOVATIONS</span>
    <span class="flex items-center gap-2"><span class="bg-[#54D69A] text-[#0A0F14] px-2 py-0.5">NOV → DEC</span> EPIC MINDS</span>
  </div>

  <!-- ─────────────────────────────────────────────── -->
  <!-- EXPERIENCE 01: Sanna Innovations               -->
  <!-- ─────────────────────────────────────────────── -->
  <div class="border-b-2 border-[#0A0F14]">
    
    <!-- Role Header Row (full-width) -->
    <div class="px-6 sm:px-12 lg:px-16 py-10 bg-[#FFD83D] flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div>
        <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest mb-2">01</div>
        <h3 class="font-heading font-black text-4xl sm:text-6xl uppercase leading-none text-[#0A0F14]">AI RESEARCH INTERN</h3>
        <div class="font-mono-tech text-base font-bold text-[#0A0F14] uppercase tracking-widest mt-2">SANNA INNOVATIONS</div>
      </div>
      <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold">
        <span class="px-3 py-1.5 bg-[#0A0F14] text-[#FFD83D]">07/2025 — 10/2025</span>
        <span class="px-3 py-1.5 bg-[#0A0F14] text-white">BENGALURU, KA</span>
      </div>
    </div>

    <!-- Content Body -->
    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#0A0F14]">
      
      <!-- Description -->
      <div class="lg:col-span-2 px-6 sm:px-12 py-10 space-y-6">
        <p class="font-sans text-base sm:text-lg text-[#0A0F14] leading-relaxed">
          Worked on client outreach through cold calls and emails and explored how AI tools enhance business communication and client engagement.
        </p>
        <!-- Keyword ticker strip inside card -->
        <div class="overflow-hidden w-full flex whitespace-nowrap border-t-2 border-[#0A0F14] pt-6">
          <div class="animate-marquee font-heading font-black text-2xl sm:text-3xl uppercase text-[#0A0F14] flex gap-10">
            <span>OUTREACH</span><span class="text-[#4A9EFF]">→</span>
            <span>COMMUNICATION</span><span class="text-[#4A9EFF]">→</span>
            <span>CLIENT ENGAGEMENT</span><span class="text-[#4A9EFF]">→</span>
            <span>OUTREACH</span><span class="text-[#4A9EFF]">→</span>
            <span>COMMUNICATION</span><span class="text-[#4A9EFF]">→</span>
            <span>CLIENT ENGAGEMENT</span>
          </div>
        </div>
      </div>

      <!-- Workflow column -->
      <div class="px-6 sm:px-8 py-10 bg-[#0A0F14] text-[#F3F1EB] flex flex-col gap-5">
        <div class="font-mono-tech text-xs font-bold text-[#FFD83D] uppercase tracking-widest">WHAT I WORKED AROUND</div>
        <div class="font-heading font-black text-xl uppercase leading-snug space-y-4">
          <div>CLIENT OUTREACH</div>
          <div class="text-[#4A9EFF] text-sm">↓</div>
          <div>AI IN BUSINESS COMMS</div>
          <div class="text-[#4A9EFF] text-sm">↓</div>
          <div>CLIENT ENGAGEMENT</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Transition Banner -->
  <div class="px-6 sm:px-12 lg:px-16 py-8 border-b-2 border-[#0A0F14] flex flex-col sm:flex-row items-center gap-4 sm:gap-12 font-heading font-black uppercase">
    <span class="text-sm font-mono-tech font-bold text-[#0A0F14]/40 tracking-widest">TWO INTERNSHIPS. TWO DIFFERENT WAYS OF WORKING.</span>
    <div class="flex items-center gap-4 text-xl sm:text-2xl">
      <span class="text-[#4A9EFF]">OUTREACH × AI</span>
      <span class="text-[#0A0F14]/20">→</span>
      <span class="text-[#54D69A]">DOCS × DEV SUPPORT</span>
    </div>
  </div>

  <!-- ─────────────────────────────────────────────── -->
  <!-- EXPERIENCE 02: Epic Minds                      -->
  <!-- ─────────────────────────────────────────────── -->
  <div class="border-b-2 border-[#0A0F14]">

    <!-- Role Header Row -->
    <div class="px-6 sm:px-12 lg:px-16 py-10 bg-[#54D69A] flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div>
        <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest mb-2">02</div>
        <h3 class="font-heading font-black text-4xl sm:text-6xl uppercase leading-none text-[#0A0F14]">AIML INTERN</h3>
        <div class="font-mono-tech text-base font-bold text-[#0A0F14] uppercase tracking-widest mt-2">EPIC MINDS</div>
      </div>
      <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold">
        <span class="px-3 py-1.5 bg-[#0A0F14] text-[#54D69A]">11/2025 — 12/2025</span>
        <span class="px-3 py-1.5 bg-[#0A0F14] text-white">BENGALURU, KA</span>
      </div>
    </div>

    <!-- Content Body -->
    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#0A0F14]">

      <!-- Workflow column (left) -->
      <div class="px-6 sm:px-8 py-10 bg-[#0A0F14] text-[#F3F1EB] flex flex-col gap-5 order-2 lg:order-1">
        <div class="font-mono-tech text-xs font-bold text-[#54D69A] uppercase tracking-widest">WHAT I CONTRIBUTED TO</div>
        <div class="font-heading font-black text-xl uppercase leading-snug space-y-4">
          <div>DESIGN DOCUMENTS</div>
          <div class="text-[#54D69A] text-sm">↓</div>
          <div>TECHNICAL INFORMATION</div>
          <div class="text-[#54D69A] text-sm">↓</div>
          <div>DEVELOPMENT SUPPORT</div>
        </div>
      </div>

      <!-- Description -->
      <div class="lg:col-span-2 px-6 sm:px-12 py-10 space-y-6 order-1 lg:order-2">
        <p class="font-sans text-base sm:text-lg text-[#0A0F14] leading-relaxed">
          Contributed to the project lifecycle by preparing design documents, organizing technical information, and supporting the team with development-related tasks when required.
        </p>
        <div class="pt-6 border-t-2 border-[#0A0F14] flex flex-wrap gap-4 font-heading font-black text-3xl sm:text-4xl uppercase text-[#0A0F14]">
          <span class="hover:text-[#54D69A] transition-colors cursor-default">DOCUMENT.</span>
          <span class="hover:text-[#54D69A] transition-colors cursor-default">ORGANIZE.</span>
          <span class="hover:text-[#54D69A] transition-colors cursor-default">SUPPORT.</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer Transition -->
  <div class="px-6 sm:px-12 lg:px-16 py-16 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8">
    <div class="font-heading font-black text-3xl sm:text-5xl uppercase leading-tight text-[#0A0F14]">
      FROM WORKING ON PROJECTS<br>
      <span class="text-[#FF6B22]">TO BUILDING MY OWN.</span>
    </div>
    <a href="#geniusphere" class="font-heading font-black text-lg uppercase px-8 py-4 bg-[#0A0F14] text-[#FFD83D] border-2 border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-colors flex items-center gap-3 group brutal-shadow-lg">
      GENIUSPHERE <span class="group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  </div>

</section>
