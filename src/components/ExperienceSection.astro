---
---

<section id="experience" class="w-full py-20 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#F3F1EB] relative">
  <div class="max-w-6xl mx-auto space-y-24">
    
    <!-- 01. Section Opening -->
    <div class="space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 border-b-2 border-[#0A0F14] pb-6">
        <div class="space-y-4 max-w-2xl">
          <h2 class="font-heading font-black text-4xl sm:text-6xl uppercase tracking-tight text-[#0A0F14] leading-none">
            PROFESSIONAL WORK
          </h2>
          <p class="font-sans text-base sm:text-lg text-[#0A0F14]/70 leading-relaxed font-medium">
            A few places where I got to work, contribute, and explore beyond the classroom.
          </p>
        </div>
        
        <div class="text-right flex flex-col items-end">
          <div class="font-heading font-black text-5xl sm:text-7xl text-[#FFD83D] drop-shadow-[2px_2px_0px_#0A0F14] leading-none">
            02
          </div>
          <div class="font-mono-tech text-xs sm:text-sm font-bold text-[#0A0F14] uppercase tracking-widest mt-2">
            INTERNSHIPS / 2025
          </div>
        </div>
      </div>

      <!-- Chronology Line -->
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14] pt-4">
        <div class="flex flex-col sm:flex-row gap-6 sm:gap-12 items-start sm:items-center">
          <div class="text-lg font-heading font-black uppercase">2025</div>
          <div class="flex items-center gap-4">
            <span class="bg-[#0A0F14] text-white px-2 py-0.5">07 → 10</span>
            <span class="uppercase tracking-widest text-[#4A9EFF]">SANNA INNOVATIONS</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="bg-[#0A0F14] text-white px-2 py-0.5">11 → 12</span>
            <span class="uppercase tracking-widest text-[#54D69A]">EPIC MINDS</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 02. First Experience: Sanna Innovations -->
    <div class="bg-white brutal-border-thick brutal-shadow-lg flex flex-col relative overflow-hidden">
      
      <!-- Top Marquee Bar -->
      <div class="border-b-2 border-[#0A0F14] bg-[#FFD83D] overflow-hidden w-full flex whitespace-nowrap mask-edges py-2">
        <div class="animate-marquee font-mono-tech text-xs font-bold uppercase text-[#0A0F14] flex items-center gap-8">
          <span>OUTREACH</span><span>★</span>
          <span>COMMUNICATION</span><span>★</span>
          <span>CLIENT ENGAGEMENT</span><span>★</span>
          <span>OUTREACH</span><span>★</span>
          <span>COMMUNICATION</span><span>★</span>
          <span>CLIENT ENGAGEMENT</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-0">
        <!-- Main Info -->
        <div class="lg:col-span-3 p-8 sm:p-10 space-y-6 flex flex-col justify-center">
          <div class="space-y-2">
            <h3 class="font-heading font-black text-3xl sm:text-5xl uppercase leading-tight text-[#0A0F14]">
              AI RESEARCH INTERN
            </h3>
            <div class="font-mono-tech font-bold text-lg text-[#4A9EFF] uppercase tracking-widest">
              SANNA INNOVATIONS
            </div>
          </div>
          
          <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold text-[#0A0F14]/70">
            <span class="px-3 py-1 bg-[#F3F1EB] brutal-border">07/2025 — 10/2025</span>
            <span class="px-3 py-1 bg-[#F3F1EB] brutal-border">BENGALURU, KARNATAKA</span>
          </div>

          <p class="font-sans text-sm sm:text-base text-[#0A0F14] leading-relaxed pt-4 border-t-2 border-[#0A0F14]/10">
            Worked on client outreach through cold calls and emails and explored how AI tools enhance business communication and client engagement.
          </p>
        </div>

        <!-- Workflow Box -->
        <div class="lg:col-span-2 bg-[#0A0F14] text-[#F3F1EB] p-8 sm:p-10 border-t-2 lg:border-t-0 lg:border-l-2 border-[#0A0F14] flex flex-col justify-center">
          <div class="font-mono-tech text-xs font-bold text-[#FFD83D] uppercase tracking-widest mb-6">
            WHAT I WORKED AROUND
          </div>
          <div class="space-y-4 font-heading font-black text-xl sm:text-2xl uppercase leading-none">
            <div>CLIENT OUTREACH</div>
            <div class="text-[#4A9EFF] text-base">↓</div>
            <div>AI IN BUSINESS COMMUNICATION</div>
            <div class="text-[#4A9EFF] text-base">↓</div>
            <div>CLIENT ENGAGEMENT</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 03. Transition Statement -->
    <div class="py-8 text-center max-w-3xl mx-auto space-y-4">
      <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/60 uppercase tracking-widest">
        TWO INTERNSHIPS. TWO DIFFERENT WAYS OF WORKING.
      </div>
      <div class="font-heading font-black text-xl sm:text-3xl text-[#0A0F14] flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 uppercase border-y-2 border-[#0A0F14] py-4">
        <span class="text-[#4A9EFF]">OUTREACH × AI</span>
        <span class="text-[#0A0F14]/30 hidden sm:block">→</span>
        <span class="text-[#54D69A]">DOCUMENTATION × DEVELOPMENT SUPPORT</span>
      </div>
    </div>

    <!-- 04. Second Experience: Epic Minds -->
    <div class="bg-[#54D69A] brutal-border-thick brutal-shadow-lg flex flex-col relative overflow-hidden">
      
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-0">
        <!-- Main Info -->
        <div class="lg:col-span-3 p-8 sm:p-10 space-y-6 flex flex-col justify-center order-2 lg:order-1">
          <div class="space-y-2">
            <h3 class="font-heading font-black text-3xl sm:text-5xl uppercase leading-tight text-[#0A0F14]">
              AIML INTERN
            </h3>
            <div class="font-mono-tech font-bold text-lg text-white uppercase tracking-widest drop-shadow-[1px_1px_0px_#0A0F14]">
              EPIC MINDS
            </div>
          </div>
          
          <div class="flex flex-wrap gap-3 font-mono-tech text-xs font-bold text-[#0A0F14]/80">
            <span class="px-3 py-1 bg-white brutal-border">11/2025 — 12/2025</span>
            <span class="px-3 py-1 bg-white brutal-border">BENGALURU, KARNATAKA</span>
          </div>

          <p class="font-sans text-sm sm:text-base text-[#0A0F14] leading-relaxed pt-4 border-t-2 border-[#0A0F14]">
            Contributed to the project lifecycle by preparing design documents, organizing technical information, and supporting the team with development-related tasks when required.
          </p>
          
          <!-- Visual Keyword Block -->
          <div class="pt-6 font-heading font-black text-3xl sm:text-4xl uppercase text-white drop-shadow-[2px_2px_0px_#0A0F14] flex flex-wrap gap-4 leading-none">
            <span class="hover:text-[#FFD83D] transition-colors">DOCUMENT.</span>
            <span class="hover:text-[#FFD83D] transition-colors">ORGANIZE.</span>
            <span class="hover:text-[#FFD83D] transition-colors">SUPPORT.</span>
          </div>
        </div>

        <!-- Workflow Box -->
        <div class="lg:col-span-2 bg-white text-[#0A0F14] p-8 sm:p-10 border-b-2 lg:border-b-0 lg:border-l-2 border-[#0A0F14] flex flex-col justify-center order-1 lg:order-2">
          <div class="font-mono-tech text-xs font-bold text-[#FF6B22] uppercase tracking-widest mb-6">
            WHAT I CONTRIBUTED TO
          </div>
          <div class="space-y-4 font-heading font-black text-xl sm:text-2xl uppercase leading-none">
            <div>DESIGN DOCUMENTS</div>
            <div class="text-[#54D69A] text-base">↓</div>
            <div>TECHNICAL INFORMATION</div>
            <div class="text-[#54D69A] text-base">↓</div>
            <div>DEVELOPMENT SUPPORT</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 05. A Really Good Ending / Transition to Next Section -->
    <div class="pt-16 pb-8 flex flex-col items-center justify-center text-center space-y-6">
      <div class="font-heading font-black text-2xl sm:text-4xl lg:text-5xl uppercase leading-[1.1] text-[#0A0F14]">
        FROM WORKING ON PROJECTS <br>
        <span class="text-[#FF6B22]">TO BUILDING SOMETHING OF MY OWN.</span>
      </div>
      <a href="#geniusphere" class="mt-6 px-6 py-3 bg-[#0A0F14] text-[#FFD83D] font-heading font-black text-xl sm:text-2xl uppercase brutal-border hover:bg-[#4A9EFF] hover:text-[#0A0F14] transition-colors flex items-center gap-3 group">
        <span>GENIUSPHERE</span>
        <span class="group-hover:translate-x-1 transition-transform">↗</span>
      </a>
    </div>

  </div>
</section>
