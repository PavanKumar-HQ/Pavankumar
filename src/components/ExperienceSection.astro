---
---

<section id="experience" class="w-full bg-[#F3F1EB] border-b-2 border-[#0A0F14] px-6 sm:px-12 lg:px-20 py-10">

  <!-- Section Header — compact -->
  <div class="flex items-center gap-4 mb-8">
    <div class="font-mono-tech text-[10px] font-bold text-[#0A0F14]/40 uppercase tracking-[0.2em] whitespace-nowrap">03 / EXPERIENCE</div>
    <div class="h-px flex-1 bg-[#0A0F14]/10"></div>
  </div>

  <!-- Two cards side by side on desktop, stacked on mobile -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 max-w-4xl">

    <!-- ── Sanna Innovations ── -->
    <div class="bg-white border-2 border-[#0A0F14] border-l-4 border-l-[#4A9EFF] hover:shadow-[4px_4px_0px_0px_#0A0F14] transition-shadow duration-200">
      <!-- Card header -->
      <div class="flex items-start gap-3 p-4 border-b border-[#0A0F14]/10">
        <div class="w-10 h-10 bg-[#0A0F14] flex items-center justify-center shrink-0">
          <span class="font-heading font-black text-sm text-[#FFD83D]">SI</span>
        </div>
        <div class="min-w-0">
          <div class="font-heading font-black text-base uppercase leading-tight text-[#0A0F14]">AI Research Intern</div>
          <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
            <span class="font-mono-tech text-xs font-bold text-[#0A0F14]">Sanna Innovations</span>
            <span class="font-mono-tech text-[9px] font-bold bg-[#4A9EFF] text-white px-1.5 py-0.5 uppercase">Internship</span>
          </div>
          <div class="font-mono-tech text-[10px] text-[#0A0F14]/40 mt-0.5">Jul – Oct 2025 · 4 mo · Bengaluru</div>
        </div>
      </div>
      <!-- Body -->
      <div class="p-4 space-y-3">
        <ul class="space-y-1.5">
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#4A9EFF] shrink-0"></span>
            Client outreach via cold calls and email campaigns
          </li>
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#4A9EFF] shrink-0"></span>
            Applied AI tools to improve business communication
          </li>
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#4A9EFF] shrink-0"></span>
            Contributed to client engagement strategies
          </li>
        </ul>
        <!-- Tags -->
        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[#0A0F14]/10">
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#4A9EFF]/10 text-[#1D6EFF] border border-[#4A9EFF]/30">CLIENT OUTREACH</span>
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#FFD83D]/20 text-[#0A0F14] border border-[#FFD83D]">AI TOOLS</span>
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#F3F1EB] text-[#0A0F14] border border-[#0A0F14]/20">COLD CALLING</span>
        </div>
      </div>
    </div>

    <!-- ── Epic Minds ── -->
    <div class="bg-white border-2 border-[#0A0F14] border-l-4 border-l-[#54D69A] hover:shadow-[4px_4px_0px_0px_#0A0F14] transition-shadow duration-200">
      <!-- Card header -->
      <div class="flex items-start gap-3 p-4 border-b border-[#0A0F14]/10">
        <div class="w-10 h-10 bg-[#54D69A] border-2 border-[#0A0F14] flex items-center justify-center shrink-0">
          <span class="font-heading font-black text-sm text-[#0A0F14]">EM</span>
        </div>
        <div class="min-w-0">
          <div class="font-heading font-black text-base uppercase leading-tight text-[#0A0F14]">AIML Intern</div>
          <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
            <span class="font-mono-tech text-xs font-bold text-[#0A0F14]">Epic Minds</span>
            <span class="font-mono-tech text-[9px] font-bold bg-[#0A8A4A] text-white px-1.5 py-0.5 uppercase">Internship</span>
          </div>
          <div class="font-mono-tech text-[10px] text-[#0A0F14]/40 mt-0.5">Nov – Dec 2025 · 2 mo · Bengaluru</div>
        </div>
      </div>
      <!-- Body -->
      <div class="p-4 space-y-3">
        <ul class="space-y-1.5">
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#54D69A] shrink-0"></span>
            Prepared design documents and technical specifications
          </li>
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#54D69A] shrink-0"></span>
            Organized technical information across the project lifecycle
          </li>
          <li class="flex items-start gap-2 font-sans text-xs text-[#0A0F14]/80">
            <span class="mt-1.5 w-1 h-1 bg-[#54D69A] shrink-0"></span>
            Supported the dev team with AIML-related tasks
          </li>
        </ul>
        <!-- Tags -->
        <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[#0A0F14]/10">
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#54D69A]/15 text-[#0A8A4A] border border-[#54D69A]/50">AIML</span>
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#F3F1EB] text-[#0A0F14] border border-[#0A0F14]/20">DOCUMENTATION</span>
          <span class="font-mono-tech text-[9px] font-bold px-2 py-0.5 bg-[#F3F1EB] text-[#0A0F14] border border-[#0A0F14]/20">TECH WRITING</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Compact bottom CTA -->
  <div class="max-w-4xl mt-8 pt-6 border-t-2 border-[#0A0F14]/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="font-heading font-black text-xl sm:text-2xl uppercase text-[#0A0F14] leading-tight">
      From internships — <span class="text-[#FF6B22]">to building my own.</span>
    </div>
    <a href="#geniusphere" class="flex items-center gap-2 bg-[#0A0F14] text-[#FFD83D] px-5 py-2.5 font-heading font-black text-sm uppercase border-2 border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-colors group shrink-0">
      GENIUSPHERE <span class="group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  </div>

</section>
