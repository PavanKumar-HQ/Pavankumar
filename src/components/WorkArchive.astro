---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<section id="work" class="py-24 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#F3F1EB] relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FFD83D] text-[#0A0F14] font-mono-tech text-xs font-bold mb-4 brutal-border">
          [04] SELECTED WORK & EVIDENCE
        </div>
        <h2 class="font-heading font-black text-4xl sm:text-6xl uppercase tracking-tight">
          WHAT I'VE BUILT
        </h2>
      </div>

      <div class="font-mono-tech text-xs text-[#0A0F14]/70 font-bold">
        EXPLORE BY CATEGORY: VENTURES • INITIATIVES • SYSTEMS • LAB
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <article class="bg-white p-8 brutal-border-thick brutal-shadow-hover flex flex-col justify-between group relative cursor-pointer" data-project-id={project.id}>
          <div>
            <div class="flex justify-between items-center font-mono-tech text-xs font-bold mb-4">
              <span class="px-2.5 py-1 bg-[#0A0F14] text-[#FFD83D] uppercase">{project.data.category}</span>
              <span class="text-[#0A0F14]/60">{project.data.year}</span>
            </div>

            <h3 class="font-heading font-black text-3xl sm:text-4xl uppercase mb-2 group-hover:text-[#4A9EFF] transition-colors">
              {project.data.title}
            </h3>
            <p class="font-mono-tech text-xs font-bold text-[#FF6B22] uppercase mb-4">
              {project.data.subtitle}
            </p>
            <p class="font-sans text-sm text-[#0A0F14]/80 leading-relaxed mb-6">
              {project.data.description}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-2 mb-6 font-mono-tech text-[11px] font-bold">
              {project.data.techStack.map((tech) => (
                <span class="px-2 py-0.5 bg-[#F3F1EB] brutal-border">{tech}</span>
              ))}
            </div>

            <div class="pt-4 border-t-2 border-[#0A0F14] flex justify-between items-center font-mono-tech text-xs font-bold">
              <span>ROLE: {project.data.role}</span>
              <span class="w-7 h-7 bg-[#0A0F14] text-white flex items-center justify-center font-black group-hover:bg-[#FFD83D] group-hover:text-[#0A0F14] transition-colors">↗</span>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
