---
const heroKeys = [
  // Row 1
  { letter: "</>", bg: "bg-white", textColor: "text-[#0A0F14]", isIcon: true },
  { letter: "P", bg: "bg-[#FF6B22]", textColor: "text-[#0A0F14]" },
  { letter: "A", bg: "bg-[#4A9EFF]", textColor: "text-[#0A0F14]" },
  { letter: "V", bg: "bg-[#54D69A]", textColor: "text-[#0A0F14]" },

  // Row 2
  { letter: "A", bg: "bg-[#FFD83D]", textColor: "text-[#0A0F14]" },
  { letter: "N", bg: "bg-[#DCC5FF]", textColor: "text-[#0A0F14]" },
  { letter: "K", bg: "bg-[#FF6B22]", textColor: "text-[#0A0F14]" },
  { letter: "U", bg: "bg-[#54D69A]", textColor: "text-[#0A0F14]" },

  // Row 3
  { letter: "M", bg: "bg-[#4A9EFF]", textColor: "text-[#0A0F14]" },
  { letter: "⚡", bg: "bg-[#FFD83D]", textColor: "text-[#0A0F14]", isIcon: true },
  { letter: "⌘", bg: "bg-[#0A0F14]", textColor: "text-[#F3F1EB]", isIcon: true },
  { letter: "...", bg: "bg-white", textColor: "text-[#0A0F14]", isIcon: true },
];
---

<section id="hero" class="relative w-full min-h-[90vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16 border-b-3 border-[#0A0F14] overflow-hidden bg-[#F3F1EB] bg-grid-pattern">
  
  <!-- Top Continuous Marquee Ticker Bar -->
  <div class="bg-[#0A0F14] text-[#FFD83D] py-3 brutal-border-thick overflow-hidden select-none mb-4 -mx-6 sm:-mx-12 lg:-mx-16 border-l-0 border-r-0">
    <div class="ticker-track font-mono-tech font-bold text-xs sm:text-sm tracking-widest uppercase">
      <!-- Copy 1 -->
      <div class="ticker-set flex shrink-0 items-center">
        <span class="px-8">★ BCA STUDENT</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ FOUNDER OF GENIUSPHERE</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ CO-FOUNDER OF BRANDEX</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ AI ENTHUSIAST</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ BENGALURU, INDIA</span>
        <span class="opacity-30">·</span>
      </div>
      <!-- Copy 2 (identical — for seamless loop) -->
      <div class="ticker-set flex shrink-0 items-center" aria-hidden="true">
        <span class="px-8">★ BCA STUDENT</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ FOUNDER OF GENIUSPHERE</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ CO-FOUNDER OF BRANDEX</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ AI ENTHUSIAST</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ BENGALURU, INDIA</span>
        <span class="opacity-30">·</span>
      </div>
    </div>
  </div>

  <!-- Main Hero 2-Column Content Layout -->
  <div class="my-4 lg:my-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Left Column: Title & Greeting -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      <!-- Creative Neo-Brutalist Greeting Tag with Animated Waving Hand -->
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 bg-[#4A9EFF] text-white font-mono-tech text-xs sm:text-sm font-bold uppercase brutal-border-thick rotate-1 hover:-rotate-1 transition-transform duration-200 shadow-[4px_4px_0px_0px_#0A0F14] select-none w-max">
        <span class="inline-block animate-wave origin-[70%_70%]">
          <svg class="w-5 h-5 text-[#FFD83D] fill-current" viewBox="0 0 24 24">
            <path d="M12 2a1 1 0 0 1 1 1v8a1 1 0 0 1-2 0V3a1 1 0 0 1 1-1zm3 3a1 1 0 0 1 1 1v6a1 1 0 0 1-2 0V6a1 1 0 0 1 1-1zm3 3a1 1 0 0 1 1 1v4a1 1 0 0 1-2 0V9a1 1 0 0 1 1-1zm-9-1a1 1 0 0 1 1 1v5a1 1 0 0 1-2 0V8a1 1 0 0 1 1-1zM6.5 11a1.5 1.5 0 0 0-1.5 1.5v3.6c0 3.3 2.7 6 6 6h2.5c3.6 0 6.5-2.9 6.5-6.5V13a1 1 0 1 0-2 0v2.6c0 2.5-2 4.5-4.5 4.5H11c-2.2 0-4-1.8-4-4v-3.6A1.5 1.5 0 0 0 5.5 11z"/>
          </svg>
        </span>
        <span id="greeting-switcher">SAY HELLO!</span>
      </div>

      <h1 id="hero-title" class="font-heading font-black text-6xl sm:text-8xl md:text-9xl lg:text-[10rem] xl:text-[11.5rem] leading-[0.82] tracking-tighter uppercase select-none text-[#0A0F14]">
        <span class="block cursor-default overflow-hidden flex" id="word-pavan">
          <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">P</span>
          <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">A</span>
          <span class="char inline-block translate-y-full hover:text-[#54D69A] transition-colors duration-200 cursor-pointer">V</span>
          <span class="char inline-block translate-y-full hover:text-[#FFD83D] transition-colors duration-200 cursor-pointer">A</span>
          <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">N</span>
        </span>
        <span class="inline-block mt-2 cursor-default overflow-hidden bg-[#FFD83D] text-[#0A0F14] px-4 py-1 brutal-border-thick -rotate-2 hover:rotate-0 transition-transform duration-300 shadow-[6px_6px_0px_0px_#0A0F14]" id="word-kumar">
          <span class="flex">
            <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">K</span>
            <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">U</span>
            <span class="char inline-block translate-y-full hover:text-[#54D69A] transition-colors duration-200 cursor-pointer">M</span>
            <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">A</span>
            <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">R</span>
          </span>
        </span>
      </h1>
    </div>

    <!-- Right Column: Truncated Pyramid Right-Side View Mechanical Key Grid -->
    <div id="keyboard-cluster" class="mt-8 lg:mt-0 grid lg:col-span-5 grid-cols-4 gap-3 sm:gap-4 xl:gap-5 items-center justify-items-center w-full select-none z-0">
      {heroKeys.map((k) => (
        <button class="group cursor-pointer select-none keycap-btn focus:outline-none" aria-label={`Mechanical Key ${k.letter}`}>
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 xl:w-24 xl:h-24 flex items-center justify-center">
            <!-- 1. Solid Black Base Shadow -->
            <div class="absolute inset-0 bg-[#0A0F14] rounded-2xl translate-x-2.5 translate-y-2.5 sm:translate-x-3 sm:translate-y-3"></div>

            <!-- 2. Dark Mechanical Switch Housing Base -->
            <div class="absolute inset-0 bg-[#1A202C] border-2 sm:border-3 border-[#0A0F14] rounded-2xl translate-x-1 sm:translate-x-1.5 translate-y-1 sm:translate-y-1.5"></div>

            <!-- 3. Keycap Body Right-Side Extrusion Wall -->
            <div class={`absolute inset-0 ${k.bg} border-3 sm:border-4 border-[#0A0F14] rounded-2xl translate-x-0.5 sm:translate-x-1 translate-y-px sm:translate-y-0.5`}></div>

            <!-- 4. Keycap Sculpted Top Face (Truncated Pyramid - Inset 85% & Shifted to show Right Side View) -->
            <div class={`relative w-[85%] h-[85%] ${k.bg} border-3 sm:border-4 border-[#0A0F14] rounded-xl flex items-center justify-center -translate-x-1 -translate-y-1 sm:-translate-y-1.5 group-hover:translate-x-0 group-hover:-translate-y-0.5 group-active:translate-x-0.5 group-active:translate-y-0.5 transition-transform duration-150 shadow-[inset_0_-3px_0_rgba(0,0,0,0.2),inset_0_3px_0_rgba(255,255,255,0.35)]`}>
              
              <!-- Keycap Concave Top Dish Highlight -->
              <div class="absolute inset-1 rounded-lg border border-[#0A0F14]/15 pointer-events-none"></div>

              <span class={`font-heading font-black ${k.textColor} ${k.isIcon ? 'text-base sm:text-lg xl:text-xl font-mono' : 'text-xl sm:text-2xl xl:text-3xl'}`}>
                {k.letter}
              </span>
            </div>
          </div>
        </button>
      ))}
    </div>

  </div>

  <!-- Editorial Statement Box with Full-Width Rigid Layout -->
  <div class="mt-4 relative z-10">
    <div class="w-full font-mono-tech space-y-4 bg-[#54D69A] text-[#0A0F14] p-6 sm:p-8 brutal-border-thick brutal-shadow-lg flex flex-col justify-between h-[260px] sm:h-[220px] overflow-hidden">
      <div class="h-full flex flex-col justify-between">
        <div class="h-[120px] flex items-center overflow-hidden my-auto">
          <p id="typewriter-title" class="font-bold text-2xl sm:text-4xl lg:text-5xl text-[#0A0F14] font-heading leading-tight uppercase">
            <!-- Typewriter content injected here -->
          </p>
        </div>

        <p class="text-[#0A0F14] font-medium text-xs sm:text-sm leading-relaxed border-t-2 border-[#0A0F14] pt-3">
          Passionate 2nd-year BCA student building real-world AI tools, Geniusphere educational programs, & modern web apps.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from 'gsap';

    // 1. GSAP Staggered Kinetic Character Reveal
    const chars = document.querySelectorAll('#hero-title .char');
    if (chars.length > 0) {
      gsap.to(chars, {
        y: '0%',
        duration: 1,
        stagger: 0.06,
        ease: 'back.out(1.7)',
        delay: 0.2
      });

      // Colors to cycle through for mobile demo effect
      const colors = ['#FF6B22', '#4A9EFF', '#54D69A', '#FFD83D', '#DCC5FF'];

      // Magnetic Distortion & Micro-Bounce on Hover
      chars.forEach((char, index) => {
        // Desktop Hover effect
        char.addEventListener('mouseenter', () => {
          gsap.to(char, {
            y: '-15%',
            scale: 1.15,
            duration: 0.15,
            ease: 'power2.out'
          });
        });
        char.addEventListener('mouseleave', () => {
          gsap.to(char, {
            y: '0%',
            scale: 1,
            duration: 0.3,
            ease: 'elastic.out(1, 0.4)'
          });
        });
      });

      // Mobile Automatic Hover Demo Effect (Since there is no cursor)
      const isMobile = window.matchMedia('(max-width: 1024px)').matches;
      if (isMobile) {
        let currentIndex = 0;
        setInterval(() => {
          const char = chars[currentIndex] as HTMLElement;
          if (char) {
            // Apply bounce and color
            gsap.to(char, {
              y: '-15%',
              scale: 1.15,
              color: colors[currentIndex % colors.length],
              duration: 0.15,
              ease: 'power2.out',
              onComplete: () => {
                gsap.to(char, {
                  y: '0%',
                  scale: 1,
                  color: '#0A0F14',
                  duration: 0.4,
                  ease: 'elastic.out(1, 0.4)'
                });
              }
            });
          }
          currentIndex = (currentIndex + 1) % chars.length;
        }, 300); // Trigger a wave every 300ms across the letters
      }
    }

    // Typewriter Loop
    const typewriterElement = document.getElementById('typewriter-title');
    const phrases = [
      "I BUILD, I BREAK, AND I BUILD BETTER."
    ];

    let phraseIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function typeEffect() {
      if (!typewriterElement) return;
      const currentPhrase = phrases[phraseIdx];
      
      if (isDeleting) {
        typewriterElement.innerText = currentPhrase.substring(0, charIdx - 1);
        charIdx--;
      } else {
        typewriterElement.innerText = currentPhrase.substring(0, charIdx + 1);
        charIdx++;
      }

      let speed = isDeleting ? 30 : 60;

      if (!isDeleting && charIdx === currentPhrase.length) {
        speed = 2500;
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        speed = 500;
      }

      setTimeout(typeEffect, speed);
    }

    typeEffect();

    // Multilingual Neo-Brutalist Greeting Switcher
    const greetings = [
      "HELLO, WORLD!",
      "NAMASTE!",
      "CREATIVE BUILDER",
      "WELCOME TO MY ARCHIVE"
    ];
    let gIdx = 0;
    const greetingEl = document.getElementById('greeting-switcher');
    if (greetingEl) {
      setInterval(() => {
        gIdx = (gIdx + 1) % greetings.length;
        greetingEl.innerText = greetings[gIdx];
      }, 2500);
    }

    // Web Audio Synthesized Mechanical Key Sound
    function playClickSound() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(550, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.035);
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.035);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.035);
      } catch (e) {}
    }

    const keyBtns = document.querySelectorAll('.keycap-btn');
    keyBtns.forEach((btn) => {
      btn.addEventListener('click', playClickSound);
    });
  </script>
</section>
