---
const letters = [
  // Row 0
  { letter: "P", color: "bg-[#FF6B22]", sideColor: "#c94a0b" },
  { letter: "A", color: "bg-[#DCC5FF]", sideColor: "#9a7bc7" },
  { letter: "V", color: "bg-[#54D69A]", sideColor: "#329668" },
  { letter: "A", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },
  { letter: "N", color: "bg-[#4A9EFF]", sideColor: "#266cc7" },
  { letter: "</>", color: "bg-[#F3F1EB]", sideColor: "#c8c6c0" },

  // Row 1
  { letter: "K", color: "bg-[#54D69A]", sideColor: "#329668" },
  { letter: "U", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },
  { letter: "M", color: "bg-[#4A9EFF]", sideColor: "#266cc7" },
  { letter: "A", color: "bg-[#FF6B22]", sideColor: "#c94a0b" },
  { letter: "R", color: "bg-[#DCC5FF]", sideColor: "#9a7bc7" },
  { letter: "⌘", color: "bg-[#F3F1EB]", sideColor: "#c8c6c0" },

  // Row 2
  { letter: "B", color: "bg-[#FF6B22]", sideColor: "#c94a0b" },
  { letter: "U", color: "bg-[#DCC5FF]", sideColor: "#9a7bc7" },
  { letter: "I", color: "bg-[#54D69A]", sideColor: "#329668" },
  { letter: "L", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },
  { letter: "D", color: "bg-[#4A9EFF]", sideColor: "#266cc7" },
  { letter: "★", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },

  // Row 3
  { letter: "W", color: "bg-[#54D69A]", sideColor: "#329668" },
  { letter: "E", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },
  { letter: "B", color: "bg-[#4A9EFF]", sideColor: "#266cc7" },
  { letter: "A", color: "bg-[#FF6B22]", sideColor: "#c94a0b" },
  { letter: "I", color: "bg-[#DCC5FF]", sideColor: "#9a7bc7" },
  { letter: "↵", color: "bg-[#F3F1EB]", sideColor: "#c8c6c0" },

  // Row 4
  { letter: "C", color: "bg-[#FF6B22]", sideColor: "#c94a0b" },
  { letter: "O", color: "bg-[#4A9EFF]", sideColor: "#266cc7" },
  { letter: "D", color: "bg-[#54D69A]", sideColor: "#329668" },
  { letter: "E", color: "bg-[#FFD83D]", sideColor: "#d9ae18" },
  { letter: "S", color: "bg-[#DCC5FF]", sideColor: "#9a7bc7" },
  { letter: "⌥", color: "bg-[#F3F1EB]", sideColor: "#c8c6c0" },
];

const colSpacing = 68;
const rowSpacing = 68;

const heroKeys = letters.map((k, i) => {
  const row = Math.floor(i / 6);
  const col = i % 6;
  const xStagger = (row % 2 === 1) ? 28 : 0;
  const jitterX = Math.round(Math.sin(i * 1.7) * 8);
  const jitterY = Math.round(Math.cos(i * 2.3) * 8);
  const angle = Math.floor(Math.sin(i * 3.1) * 16);

  return {
    ...k,
    x: Math.round(col * colSpacing + xStagger - 165 + jitterX),
    y: Math.round(row * rowSpacing - 130 + jitterY),
    angle,
    delay: `${(i % 6) * 0.12}s`
  };
});
---

<style>
  @keyframes float-idle {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
    100% { transform: translateY(0px); }
  }
  .animate-float-idle {
    animation: float-idle 3.5s ease-in-out infinite;
  }

  .key-box {
    box-shadow: 
      1px 1px 0 #0A0F14,
      2px 2px 0 var(--side-col),
      3px 3px 0 var(--side-col),
      4px 4px 0 var(--side-col),
      5px 5px 0 var(--side-col),
      6px 6px 0 var(--side-col),
      7px 7px 0 #0A0F14,
      8px 8px 0 #0A0F14;
    transition: transform 0.1s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .key-box:hover, .key-box.key-pressed {
    transform: translate(5px, 5px) !important;
    box-shadow: 
      0px 0px 0 #0A0F14,
      1px 1px 0 #0A0F14 !important;
  }
</style>

<section id="hero" class="relative w-full min-h-[90vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16 border-b-3 border-[#0A0F14] overflow-hidden bg-[#F3F1EB] bg-grid-pattern">
  
  <!-- Top Continuous Marquee Ticker Bar -->
  <div class="bg-[#0A0F14] text-[#FFD83D] py-3 brutal-border-thick overflow-hidden select-none mb-4 -mx-6 sm:-mx-12 lg:-mx-16 border-l-0 border-r-0">
    <div class="ticker-track font-mono-tech font-bold text-xs sm:text-sm tracking-widest uppercase">
      <!-- Copy 1 -->
      <div class="ticker-set flex shrink-0 items-center">
        <span class="px-8">★ BCA STUDENT</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ FOUNDER OF GENIUSPHERE</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ CO-FOUNDER OF BRANDEX</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ AI ENTHUSIAST</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ BENGALURU, INDIA</span>
        <span class="opacity-30">·</span>
      </div>
      <!-- Copy 2 -->
      <div class="ticker-set flex shrink-0 items-center" aria-hidden="true">
        <span class="px-8">★ BCA STUDENT</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ FOUNDER OF GENIUSPHERE</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ CO-FOUNDER OF BRANDEX</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ AI ENTHUSIAST</span>
        <span class="opacity-30">·</span>
        <span class="px-8">★ BENGALURU, INDIA</span>
        <span class="opacity-30">·</span>
      </div>
    </div>
  </div>

  <!-- Giant Editorial Headline Section with Side-by-Side 3D Canvas -->
  <div class="my-6 lg:my-10 relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
    
    <!-- Left Column: Editorial Headline & Statement Box -->
    <div class="w-full lg:w-[52%] xl:w-[55%] shrink-0 relative z-20">
      <!-- Creative Neo-Brutalist Greeting Tag -->
      <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 bg-[#4A9EFF] text-white font-mono-tech text-xs sm:text-sm font-bold uppercase brutal-border-thick rotate-1 hover:-rotate-1 transition-transform duration-200 shadow-[4px_4px_0px_0px_#0A0F14] select-none">
        <span class="inline-block animate-wave origin-[70%_70%]">
          <svg class="w-5 h-5 text-[#FFD83D] fill-current" viewBox="0 0 24 24">
            <path d="M12 2a1 1 0 0 1 1 1v8a1 1 0 0 1-2 0V3a1 1 0 0 1 1-1zm3 3a1 1 0 0 1 1 1v6a1 1 0 0 1-2 0V6a1 1 0 0 1 1-1zm3 3a1 1 0 0 1 1 1v4a1 1 0 0 1-2 0V9a1 1 0 0 1 1-1zm-9-1a1 1 0 0 1 1 1v5a1 1 0 0 1-2 0V8a1 1 0 0 1 1-1zM6.5 11a1.5 1.5 0 0 0-1.5 1.5v3.6c0 3.3 2.7 6 6 6h2.5c3.6 0 6.5-2.9 6.5-6.5V13a1 1 0 1 0-2 0v2.6c0 2.5-2 4.5-4.5 4.5H11c-2.2 0-4-1.8-4-4v-3.6A1.5 1.5 0 0 0 5.5 11z"/>
          </svg>
        </span>
        <span id="greeting-switcher">SAY HELLO!</span>
      </div>

      <h1 id="hero-title" class="font-heading font-black text-5xl sm:text-7xl md:text-8xl xl:text-[9.5rem] leading-[0.85] tracking-tighter uppercase select-none text-[#0A0F14]">
        <span class="block cursor-default overflow-hidden flex" id="word-pavan">
          <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">P</span>
          <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">A</span>
          <span class="char inline-block translate-y-full hover:text-[#54D69A] transition-colors duration-200 cursor-pointer">V</span>
          <span class="char inline-block translate-y-full hover:text-[#FFD83D] transition-colors duration-200 cursor-pointer">A</span>
          <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">N</span>
        </span>
        <span class="inline-block mt-2 cursor-default overflow-hidden bg-[#FFD83D] text-[#0A0F14] px-4 py-1 brutal-border-thick -rotate-2 hover:rotate-0 transition-transform duration-300 shadow-[6px_6px_0px_0px_#0A0F14]" id="word-kumar">
          <span class="flex">
            <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">K</span>
            <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">U</span>
            <span class="char inline-block translate-y-full hover:text-[#54D69A] transition-colors duration-200 cursor-pointer">M</span>
            <span class="char inline-block translate-y-full hover:text-[#FF6B22] transition-colors duration-200 cursor-pointer">A</span>
            <span class="char inline-block translate-y-full hover:text-[#4A9EFF] transition-colors duration-200 cursor-pointer">R</span>
          </span>
        </span>
      </h1>

      <div class="mt-6">
        <!-- Editorial Statement Box -->
        <div class="w-full font-mono-tech space-y-4 bg-[#54D69A] text-[#0A0F14] p-6 brutal-border-thick brutal-shadow-lg flex flex-col justify-between h-[220px] sm:h-[200px] overflow-hidden">
          <div class="h-full flex flex-col justify-between">
            <div class="h-[100px] flex items-center overflow-hidden my-auto">
              <p id="typewriter-title" class="font-bold text-xl sm:text-3xl lg:text-4xl text-[#0A0F14] font-heading leading-tight uppercase">
                <!-- Typewriter content injected here -->
              </p>
            </div>

            <p class="text-[#0A0F14] font-medium text-xs sm:text-sm leading-relaxed border-t-2 border-[#0A0F14] pt-3">
              Passionate 2nd-year BCA student building real-world AI tools, Geniusphere educational programs, & modern web apps.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Dedicated 30-Key Keyboard Canvas (100% Unobstructed & Ultra-Performance) -->
    <div class="w-full lg:w-[48%] xl:w-[45%] h-[400px] sm:h-[480px] lg:h-[540px] relative flex items-center justify-center overflow-visible z-30">
      <div class="w-full h-full flex items-center justify-center pointer-events-none" style="perspective: 2000px;">
        
        <!-- The Cluster Rotator (Static Isometric View) -->
        <div id="true-3d-cluster" class="relative pointer-events-auto w-[420px] h-[420px] flex items-center justify-center" style="transform: rotateX(50deg) rotateZ(-35deg); transform-style: preserve-3d;">
          
          {heroKeys.map((key) => (
            <div class="absolute animate-float-idle mechanical-key-wrapper" style={`transform: translate(${key.x}px, ${key.y}px) rotate(${key.angle}deg); animation-delay: ${key.delay};`}>
              
              <!-- 2.5D Isometric Mechanical Key Box -->
              <div class={`relative w-13 h-13 sm:w-15 sm:h-15 xl:w-17 xl:h-17 rounded-xl border-3 border-[#0A0F14] ${key.color} flex items-center justify-center cursor-pointer key-box select-none`} style={`--side-col: ${key.sideColor};`}>
                
                <!-- Inner bevel highlight -->
                <div class="absolute inset-0 rounded-lg shadow-[inset_0_3px_0_rgba(255,255,255,0.35),inset_0_-3px_0_rgba(0,0,0,0.12)] pointer-events-none"></div>

                <!-- Counter-rotated label so text faces up cleanly -->
                <span class="font-heading font-black text-lg sm:text-xl xl:text-2xl text-[#0A0F14] drop-shadow-sm pointer-events-none" style={`transform: rotate(${-key.angle}deg);`}>{key.letter}</span>
              </div>

            </div>
          ))}
          
        </div>
      </div>
    </div>

  </div>

  <script>
    import { gsap } from 'gsap';

    // 1. GSAP Staggered Kinetic Character Reveal
    const chars = document.querySelectorAll('#hero-title .char');
    if (chars.length > 0) {
      gsap.to(chars, {
        y: '0%',
        duration: 1,
        stagger: 0.06,
        ease: 'back.out(1.7)',
        delay: 0.2
      });

      chars.forEach((char) => {
        char.addEventListener('mouseenter', () => {
          gsap.to(char, {
            y: '-15%',
            scale: 1.15,
            duration: 0.15,
            ease: 'power2.out'
          });
        });
        char.addEventListener('mouseleave', () => {
          gsap.to(char, {
            y: '0%',
            scale: 1,
            duration: 0.3,
            ease: 'elastic.out(1, 0.4)'
          });
        });
      });
    }

    // Typewriter Loop
    const typewriterElement = document.getElementById('typewriter-title');
    const phrases = [
      "I BUILD, I BREAK, AND I BUILD BETTER."
    ];

    let phraseIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function typeEffect() {
      if (!typewriterElement) return;
      const currentPhrase = phrases[phraseIdx];
      
      if (isDeleting) {
        typewriterElement.innerText = currentPhrase.substring(0, charIdx - 1);
        charIdx--;
      } else {
        typewriterElement.innerText = currentPhrase.substring(0, charIdx + 1);
        charIdx++;
      }

      let speed = isDeleting ? 30 : 60;

      if (!isDeleting && charIdx === currentPhrase.length) {
        speed = 2500;
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        speed = 500;
      }

      setTimeout(typeEffect, speed);
    }

    // Lightweight Proximity Typing & Ghost Typing Script (0 Lag, 60FPS)
    const heroSection = document.getElementById('hero');
    const keyBoxes = document.querySelectorAll('.key-box');

    if (heroSection && keyBoxes.length > 0) {
      let ticking = false;

      heroSection.addEventListener('mousemove', (e) => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            keyBoxes.forEach((keyEl) => {
              const rect = keyEl.getBoundingClientRect();
              const keyCenterX = rect.left + rect.width / 2;
              const keyCenterY = rect.top + rect.height / 2;

              const dist = Math.hypot(e.clientX - keyCenterX, e.clientY - keyCenterY);

              if (dist < 80) {
                keyEl.classList.add('key-pressed');
              } else {
                keyEl.classList.remove('key-pressed');
              }
            });
            ticking = false;
          });
          ticking = true;
        }
      });

      heroSection.addEventListener('mouseleave', () => {
        keyBoxes.forEach((keyEl) => keyEl.classList.remove('key-pressed'));
      });

      // Ghost Typist Sequence Loop
      setInterval(() => {
        const randomIdx = Math.floor(Math.random() * keyBoxes.length);
        const targetKey = keyBoxes[randomIdx];
        if (targetKey && !targetKey.matches(':hover')) {
          targetKey.classList.add('key-pressed');
          setTimeout(() => targetKey.classList.remove('key-pressed'), 180);
        }
      }, 400);
    }

    typeEffect();

    // Multilingual Neo-Brutalist Greeting Switcher
    const greetings = [
      "HELLO, WORLD!",
      "NAMASTE!",
      "CREATIVE BUILDER",
      "WELCOME TO MY ARCHIVE"
    ];
    let gIdx = 0;
    const greetingEl = document.getElementById('greeting-switcher');
    if (greetingEl) {
      setInterval(() => {
        gIdx = (gIdx + 1) % greetings.length;
        greetingEl.innerText = greetings[gIdx];
      }, 2500);
    }
  </script>
</section>
