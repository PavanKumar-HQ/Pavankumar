---
---

<section id="hero" class="relative w-full min-h-[92vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16 border-b-3 border-[#0A0F14] overflow-hidden bg-[#F3F1EB] bg-grid-pattern">
  
  <!-- Top Technical Grid Metadata -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono-tech text-xs border-b-2 border-[#0A0F14] pb-6 bg-[#F3F1EB]/90 p-4 brutal-border">
    <div>
      <span class="text-[#0A0F14]/50 block">SYSTEM_ID</span>
      <span class="font-bold text-[#FF6B22]">PK-WORLD-2026</span>
    </div>
    <div>
      <span class="text-[#0A0F14]/50 block">LOCATION</span>
      <span class="font-bold">INDIA 🇮🇳</span>
    </div>
    <div>
      <span class="text-[#0A0F14]/50 block">OPERATING FOCUS</span>
      <span class="font-bold text-[#4A9EFF]">TECH × BUSINESS × AI</span>
    </div>
    <div>
      <span class="text-[#0A0F14]/50 block">ACTIVE VENTURE</span>
      <span class="font-bold text-[#54D69A]">BRANDEX & GENIUSPHERE</span>
    </div>
  </div>

  <!-- Giant Editorial Headline Section -->
  <div class="my-12 relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#DCC5FF] brutal-border font-mono-tech text-xs font-bold mb-6 brutal-shadow-sm">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [01] THE DIGITAL ARCHIVE & WORLD
    </div>
    
    <h1 id="hero-title" class="font-heading font-black text-6xl sm:text-8xl md:text-9xl lg:text-[12rem] leading-[0.82] tracking-tighter uppercase select-none">
      <span class="block hover:text-[#4A9EFF] transition-colors cursor-default">PAVAN</span>
      <span class="block hover:text-[#FF6B22] transition-colors cursor-default">KUMAR</span>
    </h1>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      
      <!-- Big Statement Box -->
      <div class="lg:col-span-7 font-mono-tech text-sm sm:text-base space-y-3 bg-white p-6 sm:p-8 brutal-border-thick brutal-shadow-lg">
        <div class="text-xs font-bold text-[#FF6B22] uppercase tracking-widest">[IDENTITY_MANIFESTO]</div>
        <p class="font-bold text-xl sm:text-3xl text-[#0A0F14] font-heading leading-tight">
          I BUILD THINGS. THEN I BREAK THEM. THEN I BUILD THEM BETTER.
        </p>
        <p class="text-[#0A0F14]/80 text-xs sm:text-sm leading-relaxed">
          Moving fluidly between software engineering, business strategy, educational initiatives, CRM engines, and AI experiments. Visualizing a journey beyond standard boxes.
        </p>
      </div>

      <!-- Quick Discipline Badges & Status -->
      <div class="lg:col-span-5 flex flex-wrap gap-3 justify-start lg:justify-end">
        <div class="p-4 bg-[#FFD83D] brutal-border-thick brutal-shadow-hover w-full sm:w-auto font-mono-tech">
          <div class="text-[10px] text-[#0A0F14]/60 font-bold uppercase">FOUNDER & CEO</div>
          <div class="font-heading font-black text-xl">BRANDEX</div>
        </div>
        <div class="p-4 bg-[#54D69A] brutal-border-thick brutal-shadow-hover w-full sm:w-auto font-mono-tech">
          <div class="text-[10px] text-[#0A0F14]/60 font-bold uppercase">INITIATIVE LEAD</div>
          <div class="font-heading font-black text-xl">GENIUSPHERE</div>
        </div>
        <div class="p-4 bg-[#4A9EFF] text-white brutal-border-thick brutal-shadow-hover w-full sm:w-auto font-mono-tech">
          <div class="text-[10px] text-white/70 font-bold uppercase">ARCHITECT</div>
          <div class="font-heading font-black text-xl">ESSMA OS</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Decorative Neo-Brutalist Interactive Object -->
  <div class="absolute right-6 top-1/3 w-40 h-40 sm:w-60 sm:h-60 lg:w-80 lg:h-80 bg-[#FFD83D] brutal-border-xl brutal-shadow-xl rotate-12 -z-0 hidden lg:flex flex-col justify-between p-8 select-none pointer-events-none transform hover:rotate-0 transition-transform duration-500">
    <div class="font-mono-tech text-xs font-bold text-[#0A0F14]/60">SYS_OBJECT / 001</div>
    <div class="font-heading font-black text-4xl uppercase leading-none tracking-tight">
      DIGITAL<br />PLAYGROUND
    </div>
    <div class="font-mono-tech text-xs font-bold text-[#FF6B22]">PAVAN KUMAR WORLD</div>
  </div>

  <!-- Bottom Action Bar -->
  <div class="flex justify-between items-center pt-6 border-t-2 border-[#0A0F14] font-mono-tech text-xs bg-[#F3F1EB]/90 p-2">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 bg-[#FF6B22] brutal-border animate-bounce"></span>
      <span class="font-bold">SCROLL TO UNLOCK CHAPTERS</span>
    </div>
    <div class="font-bold">CHAPTER 01 / 11</div>
  </div>
</section>
