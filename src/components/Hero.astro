---

<section id="hero" class="relative w-full min-h-[92vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16 border-b-3 border-[#0A0F14] overflow-hidden bg-[#F3F1EB] bg-grid-pattern">
  
  <!-- Giant Editorial Headline Section -->
  <div class="my-8 relative z-10">
    
    <h1 id="hero-title" class="font-heading font-black text-6xl sm:text-8xl md:text-9xl lg:text-[12rem] leading-[0.82] tracking-tighter uppercase select-none text-[#0A0F14]">
      <span class="block cursor-default">PAVAN</span>
      <span class="block cursor-default">KUMAR</span>
    </h1>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      
      <!-- Big Statement Box with Typewriter Effect -->
      <div class="lg:col-span-7 font-mono-tech text-sm sm:text-base space-y-3 bg-white p-6 sm:p-8 brutal-border-thick brutal-shadow-lg min-h-[160px]">
        <p id="typewriter-title" class="font-bold text-xl sm:text-3xl text-[#0A0F14] font-heading leading-tight min-h-[60px]">
          <!-- Typewriter content injected here -->
        </p>
        <p class="text-[#0A0F14]/80 text-xs sm:text-sm leading-relaxed">
          Moving fluidly between technology, entrepreneurship, educational initiatives, and AI products. Visualizing a journey beyond standard boxes.
        </p>
      </div>

<script>
  const typewriterElement = document.getElementById('typewriter-title');
  const phrases = [
    "I BUILD THINGS. THEN I BREAK THEM. THEN I BUILD THEM BETTER.",
    "BUILDER × ENTREPRENEUR × TECHNOLOGIST.",
    "ENGINEERING BRANDEX OS & GENIUSPHERE."
  ];

  let phraseIdx = 0;
  let charIdx = 0;
  let isDeleting = false;

  function typeEffect() {
    if (!typewriterElement) return;
    const currentPhrase = phrases[phraseIdx];
    
    if (isDeleting) {
      typewriterElement.innerText = currentPhrase.substring(0, charIdx - 1);
      charIdx--;
    } else {
      typewriterElement.innerText = currentPhrase.substring(0, charIdx + 1);
      charIdx++;
    }

    let speed = isDeleting ? 30 : 60;

    if (!isDeleting && charIdx === currentPhrase.length) {
      speed = 2500; // Pause at end of sentence
      isDeleting = true;
    } else if (isDeleting && charIdx === 0) {
      isDeleting = false;
      phraseIdx = (phraseIdx + 1) % phrases.length;
      speed = 500;
    }

    setTimeout(typeEffect, speed);
  }

  typeEffect();
</script>

      <!-- Quick Discipline Badges & Status -->
      <div class="lg:col-span-5 flex flex-wrap gap-3 justify-start lg:justify-end">
        <a href="#brandex" class="p-4 bg-[#FFD83D] brutal-border-thick brutal-shadow-hover w-full sm:w-auto font-mono-tech group">
          <div class="text-[10px] text-[#0A0F14]/70 font-bold uppercase">CORE VENTURE</div>
          <div class="font-heading font-black text-xl group-hover:text-[#FF6B22] transition-colors">BRANDEX ↗</div>
        </a>
        <a href="#geniusphere" class="p-4 bg-[#54D69A] brutal-border-thick brutal-shadow-hover w-full sm:w-auto font-mono-tech group">
          <div class="text-[10px] text-[#0A0F14]/70 font-bold uppercase">EDUCATION INITIATIVE</div>
          <div class="font-heading font-black text-xl group-hover:text-[#0A0F14] transition-colors">GENIUSPHERE ↗</div>
        </a>
      </div>

    </div>
  </div>

  <!-- Decorative Interactive Card -->
  <div class="absolute right-8 top-1/4 w-48 h-48 sm:w-64 sm:h-64 lg:w-80 lg:h-80 bg-[#4A9EFF] text-white brutal-border-xl brutal-shadow-xl rotate-6 -z-0 hidden lg:flex flex-col justify-between p-8 select-none pointer-events-none transition-transform duration-500">
    <div class="font-mono-tech text-xs font-bold text-[#FFD83D]">PERSONAL ARCHIVE</div>
    <div>
      <div class="font-heading font-black text-4xl uppercase leading-none tracking-tight">
        EXPLORE<br />THE WORLD
      </div>
      <p class="font-sans text-xs text-white/80 mt-2">Technology × Business × Community</p>
    </div>
    <div class="font-mono-tech text-xs font-bold text-white/90 border-t border-white/30 pt-2">PAVAN KUMAR — 2026</div>
  </div>

  <!-- Bottom Action Bar -->
  <div class="flex justify-between items-center pt-6 border-t-2 border-[#0A0F14] font-mono-tech text-xs bg-[#F3F1EB]/90 p-2">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 bg-[#FF6B22] brutal-border animate-bounce"></span>
      <span class="font-bold">SCROLL TO UNLOCK CHAPTERS</span>
    </div>
    <div class="font-bold">CHAPTER 01 / 11</div>
  </div>
</section>
