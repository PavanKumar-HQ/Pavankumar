---
const metrics = [
  { label: "CUSTOMERS / CLIENTS", val: "142", color: "text-[#4A9EFF]" },
  { label: "COMPLETED PROJECTS", val: "38", color: "text-[#FFD83D]" },
  { label: "ACTIVE SYSTEMS", val: "07", color: "text-[#54D69A]" },
  { label: "AUTOMATION PIPELINES", val: "21", color: "text-[#FF6B22]" }
];

const techStack = [
  "ESSMA OS", "Supabase", "Astro", "TypeScript", "Android", "Node.js", "AI Agents", "TailwindCSS", "PostgreSQL", "Vercel"
];
---

<section id="systems" class="w-full py-20 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#0A0F14] text-[#F3F1EB]">
  <div class="max-w-7xl mx-auto">
    
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#54D69A] text-[#0A0F14] font-mono-tech text-xs font-bold mb-6 brutal-border">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [07] TECHNICAL INTERFACE & ARCHITECTURE
    </div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-[#F3F1EB]/20 pb-6">
      <div>
        <h2 class="font-heading font-black text-5xl sm:text-7xl uppercase tracking-tighter text-[#F3F1EB]">
          I ALSO BUILD SYSTEMS
        </h2>
        <p class="font-mono-tech text-xs text-[#F3F1EB]/60 mt-2">TECHNICAL OPERATING SPECIFICATIONS & MONITORING DASHBOARD</p>
      </div>
      <div class="font-mono-tech text-xs text-[#54D69A] mt-4 md:mt-0 font-bold flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#54D69A] animate-pulse"></span>
        SYSTEM_STATUS: ALL_ENGINES_OPERATIONAL
      </div>
    </div>

    <!-- Real-time style System Metrics Monitor Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      {metrics.map((item) => (
        <div class="p-6 bg-[#121820] border-2 border-[#F3F1EB]/30 brutal-shadow-hover flex flex-col justify-between cursor-pointer group hover:bg-[#F3F1EB] hover:text-[#0A0F14] transition-all duration-200">
          <span class="font-mono-tech text-[10px] text-[#F3F1EB]/50 group-hover:text-[#0A0F14]/70 uppercase font-bold tracking-widest transition-colors">{item.label}</span>
          <span class={`font-heading font-black text-4xl sm:text-6xl mt-4 mb-2 ${item.color} group-hover:text-[#0A0F14] transition-colors`}>{item.val}</span>
          <div class="w-full bg-[#F3F1EB]/10 group-hover:bg-[#0A0F14]/20 h-2 overflow-hidden transition-colors">
            <div class="h-full bg-current w-3/4"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- System Terminal Architecture Display -->
    <div class="p-8 bg-[#121820] border-2 border-[#F3F1EB]/30 brutal-shadow-xl font-mono-tech">
      <div class="flex justify-between items-center text-xs border-b border-[#F3F1EB]/20 pb-4 mb-6 text-[#F3F1EB]/60">
        <span>CORE_STACK / PIPELINES</span>
        <span>SECURITY: ENCRYPTED</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <div class="text-xs text-[#4A9EFF] font-bold mb-4">[STACK_NODES]</div>
          <div class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <span class="px-3 py-1.5 bg-[#F3F1EB]/10 border border-[#F3F1EB]/30 text-xs font-mono-tech font-bold hover:bg-[#4A9EFF] hover:text-[#0A0F14] transition-colors cursor-default">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <div>
          <div class="text-xs text-[#FFD83D] font-bold mb-4">[LIVE_DIAGNOSTICS]</div>
          <div class="space-y-3 text-xs text-[#F3F1EB]/80 font-mono-tech">
            <div class="flex justify-between border-b border-[#F3F1EB]/10 pb-1">
              <span>DATABASE_LATENCY</span>
              <span class="text-[#54D69A] font-bold">12ms [SUPABASE]</span>
            </div>
            <div class="flex justify-between border-b border-[#F3F1EB]/10 pb-1">
              <span>FRONTEND_RENDER</span>
              <span class="text-[#54D69A] font-bold">ASTRO STATIC SSG</span>
            </div>
            <div class="flex justify-between border-b border-[#F3F1EB]/10 pb-1">
              <span>AUTOMATION_ENGINE</span>
              <span class="text-[#FF6B22] font-bold">CUSTOM WEBHOOK AGENTS</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
