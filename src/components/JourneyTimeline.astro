---
const milestones = [
  {
    year: "2024",
    tag: "EDUCATION & COMMUNITY",
    title: "GENIUSPHERE",
    description: "Empowering students with tech, finance, and soft skills through AI awareness & workshops.",
    metrics: "FOUNDER",
    hoverBg: "hover:bg-[#FF6B22]"
  },
  {
    year: "2025",
    tag: "CORE VENTURE",
    title: "BRANDEX",
    description: "Building scalable technology solutions, enterprise CRM workflows, and digital services.",
    metrics: "CO-FOUNDER",
    hoverBg: "hover:bg-[#4A9EFF]"
  },
  {
    year: "2025",
    tag: "INDUSTRY EXPERIENCE",
    title: "AIML RESEARCH",
    description: "Technical design at Epic Minds and AI tools for business outreach at Sanna Innovations.",
    metrics: "INTERNSHIP",
    hoverBg: "hover:bg-[#54D69A]"
  }
];
---

<section id="journey" class="w-full bg-[#F3F1EB] text-[#0A0F14] overflow-hidden pt-24 pb-0">
  
  <!-- Header -->
  <div class="px-6 sm:px-12 lg:px-16 mb-12 flex flex-col lg:flex-row justify-between lg:items-end gap-8">
    <h2 class="font-heading font-black text-6xl sm:text-8xl md:text-9xl uppercase tracking-tighter leading-[0.85] text-[#0A0F14] pb-2">
      THE <br>
      <span class="bg-[#FFD83D] px-4 border-2 border-[#0A0F14]">JOURNEY</span>
    </h2>
  </div>

  <!-- Interactive Row List (Full Row Hover Effect) -->
  <div class="w-full flex flex-col border-t-2 border-[#0A0F14]">
    {milestones.map((item) => (
      <div class={`group flex flex-col lg:flex-row border-b-2 border-[#0A0F14] transition-colors duration-300 bg-[#F3F1EB] ${item.hoverBg} cursor-default`}>
        
        <!-- Column 1: Year (Faded normally, solid black on hover) -->
        <div class="w-full lg:w-[15%] border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0F14] p-6 lg:p-8 flex items-center justify-center transition-colors duration-300">
          <span class="font-heading font-black text-5xl sm:text-6xl leading-none text-[#0A0F14]/30 group-hover:text-[#0A0F14] transition-colors duration-300">
            {item.year}
          </span>
        </div>

        <!-- Column 2: Title & Tag -->
        <div class="w-full lg:w-[35%] border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0F14] p-6 lg:p-8 flex flex-col justify-center transition-colors duration-300">
          <div class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#0A0F14]/50 group-hover:text-[#0A0F14]/80 transition-colors mb-3">
            {item.tag}
          </div>
          <h3 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl uppercase leading-[0.9] text-[#0A0F14] transition-colors duration-300">
            {item.title}
          </h3>
        </div>

        <!-- Column 3: Description -->
        <div class="w-full lg:w-[35%] border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0F14] p-6 lg:p-8 flex items-center">
          <p class="font-sans text-sm sm:text-base text-[#0A0F14]/70 group-hover:text-[#0A0F14] transition-colors leading-relaxed font-medium">
            {item.description}
          </p>
        </div>

        <!-- Column 4: Metrics & CTA -->
        <div class="w-full lg:w-[15%] p-6 lg:p-8 flex lg:flex-col justify-between items-center lg:items-end">
          <span class="font-mono-tech text-[10px] sm:text-xs font-bold uppercase tracking-widest text-left lg:text-right text-[#0A0F14]/50 group-hover:text-[#0A0F14] transition-colors">
            {item.metrics}
          </span>
          <span class="text-3xl lg:text-5xl font-black text-[#0A0F14]/20 group-hover:text-[#0A0F14] group-hover:translate-x-2 lg:group-hover:-translate-y-2 transition-all duration-300">
            ↗
          </span>
        </div>

      </div>
    ))}
  </div>

</section>
