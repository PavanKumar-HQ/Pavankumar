---
const milestones = [
  {
    year: "2024",
    tag: "EDUCATION & COMMUNITY",
    title: "GENIUSPHERE INITIATIVE",
    description: "Founded and managed Geniusphere to empower students with technology, finance, and soft skills through workshops and AI awareness.",
    textColor: "text-[#FFB800]",
    metrics: "FOUNDER & CONTRIBUTOR • 200+ STUDENTS"
  },
  {
    year: "2025",
    tag: "CORE VENTURE",
    title: "BRANDEX TECH OS",
    description: "Co-founded Brandex to build scalable technology solutions, enterprise CRM workflows, and productized digital services.",
    textColor: "text-[#4A9EFF]",
    metrics: "CO-FOUNDER • TECH & BIZ OS"
  },
  {
    year: "2025",
    tag: "INDUSTRY EXPERIENCE",
    title: "AIML & AI RESEARCH",
    description: "Prepared technical design documents at Epic Minds and explored AI tools for business outreach at Sanna Innovations.",
    textColor: "text-[#54D69A]",
    metrics: "EPIC MINDS & SANNA INNOVATIONS"
  }
];
---

<section id="journey" class="w-full py-32 bg-[#F3F1EB] overflow-hidden relative">
  
  <!-- Creative Fluid Background Elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Soft blurred orbs floating in the background instead of rigid grids -->
    <div class="absolute -top-[20%] -left-[10%] w-[60vw] h-[60vw] rounded-full bg-[#FFD83D] mix-blend-multiply blur-[120px] opacity-40 animate-pulse"></div>
    <div class="absolute top-[30%] -right-[10%] w-[50vw] h-[50vw] rounded-full bg-[#4A9EFF] mix-blend-multiply blur-[140px] opacity-30" style="animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite reverse;"></div>
    <div class="absolute -bottom-[20%] left-[20%] w-[40vw] h-[40vw] rounded-full bg-[#54D69A] mix-blend-multiply blur-[100px] opacity-20"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 relative z-10 mb-32 text-center">
    <h2 class="font-heading font-black text-6xl sm:text-8xl md:text-9xl uppercase tracking-tighter leading-none text-[#0A0F14]">
      THE JOURNEY
    </h2>
    <p class="font-mono-tech text-sm mt-6 text-[#0A0F14]/50 max-w-lg mx-auto uppercase tracking-widest">
      A timeline of initiatives, ventures, and research — flowing forward.
    </p>
  </div>

  <!-- A flowing horizontal timeline completely free of boxes -->
  <div class="relative w-full max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 z-10">
    
    <!-- Central continuous line -->
    <div class="absolute top-1/2 left-6 right-6 lg:left-16 lg:right-16 h-px bg-[#0A0F14]/10 -translate-y-1/2 hidden md:block"></div>

    <div class="flex flex-col md:flex-row justify-between items-center md:items-stretch gap-24 md:gap-8">
      {milestones.map((item, index) => (
        <div class="relative flex flex-col md:w-1/3 items-center text-center group">
          
          <!-- Node Dot on the timeline -->
          <div class="hidden md:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#0A0F14] shadow-[0_0_0_6px_#F3F1EB] z-10 group-hover:scale-[1.7] group-hover:bg-[#FF6B22] transition-all duration-500"></div>

          <!-- Top part: Year & Tag -->
          <div class="md:h-[180px] flex flex-col justify-end pb-8 md:pb-12 group-hover:-translate-y-4 transition-transform duration-500">
            <div class={`font-heading font-black text-8xl sm:text-9xl leading-none mb-4 ${item.textColor} drop-shadow-sm`}>
              {item.year}
            </div>
            <div class="font-mono-tech text-[10px] font-bold uppercase tracking-[0.25em] text-[#0A0F14]/40">
              {item.tag}
            </div>
          </div>

          <!-- Bottom part: Title & Description -->
          <div class="md:h-[220px] flex flex-col justify-start pt-8 md:pt-12 group-hover:translate-y-4 transition-transform duration-500">
            <h3 class="font-heading font-black text-2xl sm:text-3xl uppercase leading-tight mb-5 text-[#0A0F14]">
              {item.title}
            </h3>
            <p class="font-sans text-sm text-[#0A0F14]/70 leading-relaxed max-w-[280px] mx-auto font-medium">
              {item.description}
            </p>
            <div class="mt-6 font-mono-tech text-[10px] font-bold text-[#FF6B22] uppercase tracking-widest">
              {item.metrics}
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>

</section>
