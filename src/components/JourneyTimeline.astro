---
const milestones = [
  {
    year: "2024",
    tag: "EDUCATION & COMMUNITY",
    title: "GENIUSPHERE INITIATIVE",
    description: "Founded and managed Geniusphere to empower students with technology, finance, and soft skills through workshops and AI awareness.",
    headerColor: "bg-[#FFD83D]",
    metrics: "FOUNDER & CONTRIBUTOR • 200+ STUDENTS"
  },
  {
    year: "2025",
    tag: "CORE VENTURE",
    title: "BRANDEX TECH OS",
    description: "Co-founded Brandex to build scalable technology solutions, enterprise CRM workflows, and productized digital services.",
    headerColor: "bg-[#4A9EFF]",
    metrics: "CO-FOUNDER • TECH & BIZ OS"
  },
  {
    year: "2025",
    tag: "INDUSTRY EXPERIENCE",
    title: "AIML & AI RESEARCH",
    description: "Prepared technical design documents at Epic Minds and explored AI tools for business outreach at Sanna Innovations.",
    headerColor: "bg-[#54D69A]",
    metrics: "EPIC MINDS & SANNA INNOVATIONS"
  }
];
---

<section id="journey" class="w-full py-24 bg-[#FFD83D] text-[#0A0F14] border-b-2 border-[#0A0F14] overflow-hidden">
  
  <div class="px-8 sm:px-16 mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
    <div>
      <div class="inline-block px-3 py-1 bg-[#0A0F14] text-[#F3F1EB] font-mono-tech text-xs font-bold mb-6 border-2 border-[#0A0F14] shadow-[4px_4px_0_0_#0A0F14]">
        [04] THE JOURNEY
      </div>
      <h2 class="font-heading font-black text-6xl sm:text-8xl md:text-9xl uppercase tracking-tighter leading-none text-[#0A0F14]">
        TIMELINE
      </h2>
    </div>
    <div class="font-mono-tech text-xs font-bold text-[#0A0F14] uppercase tracking-widest flex items-center gap-3 pb-3">
      <span class="w-3 h-3 bg-[#FF6B22] border-2 border-[#0A0F14]"></span>
      DRAG OR SCROLL TO EXPLORE
    </div>
  </div>

  <!-- Horizontal Scroll Container -->
  <div class="flex overflow-x-auto gap-8 px-8 sm:px-16 pb-16 pt-4 snap-x snap-mandatory no-scrollbar cursor-grab active:cursor-grabbing">
    {milestones.map((item, index) => (
      <div class="snap-start shrink-0 w-[85vw] sm:w-[420px] bg-[#F3F1EB] border-4 border-[#0A0F14] shadow-[12px_12px_0_0_#0A0F14] flex flex-col group hover:-translate-y-2 transition-transform duration-300">
        
        <!-- Bold Header Block -->
        <div class={`${item.headerColor} p-6 border-b-4 border-[#0A0F14] flex justify-between items-center`}>
          <span class="font-mono-tech text-sm font-black uppercase tracking-widest text-[#0A0F14]">CHAPTER / 0{index + 1}</span>
          <span class="font-heading font-black text-5xl sm:text-6xl text-[#0A0F14] leading-none">{item.year}</span>
        </div>

        <!-- Content Block -->
        <div class="p-8 grow flex flex-col justify-start">
          <div class="inline-block bg-[#0A0F14] text-[#F3F1EB] px-3 py-1 font-mono-tech text-[10px] font-bold uppercase tracking-widest mb-6 self-start">
            {item.tag}
          </div>
          <h3 class="font-heading font-black text-4xl uppercase leading-[1.1] mb-5 text-[#0A0F14]">
            {item.title}
          </h3>
          <p class="font-sans text-base text-[#0A0F14]/80 leading-relaxed font-medium">
            {item.description}
          </p>
        </div>

        <!-- Bottom Footer -->
        <div class="p-8 pt-0">
          <div class="font-mono-tech text-xs font-bold text-[#0A0F14] uppercase tracking-widest border-t-4 border-[#0A0F14] pt-5 flex justify-between items-center">
            <span>{item.metrics}</span>
            <span class="text-[#FF6B22] group-hover:translate-x-1 transition-transform">↗</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
