---
const milestones = [
  {
    year: "2024",
    tag: "EDUCATION & COMMUNITY",
    title: "GENIUSPHERE",
    description: "Empowering students with tech, finance, and soft skills through AI awareness & workshops.",
    metrics: "FOUNDER",
    color: "group-hover:bg-[#FFD83D]"
  },
  {
    year: "2025",
    tag: "CORE VENTURE",
    title: "BRANDEX",
    description: "Building scalable technology solutions, enterprise CRM workflows, and digital services.",
    metrics: "CO-FOUNDER",
    color: "group-hover:bg-[#4A9EFF]"
  },
  {
    year: "2025",
    tag: "INDUSTRY EXPERIENCE",
    title: "AIML RESEARCH",
    description: "Technical design at Epic Minds and AI tools for business outreach at Sanna Innovations.",
    metrics: "INTERNSHIPS",
    color: "group-hover:bg-[#54D69A]"
  }
];
---

<section id="journey" class="w-full bg-[#F3F1EB] text-[#0A0F14] overflow-hidden pt-24 pb-0">
  
  <!-- Header -->
  <div class="px-6 sm:px-12 lg:px-16 mb-16 flex flex-col lg:flex-row justify-between lg:items-end gap-8">
    <h2 class="font-heading font-black text-[clamp(4rem,10vw,10rem)] uppercase tracking-tighter leading-[0.8] text-[#0A0F14]">
      THE<br>JOURNEY
    </h2>
    <div class="flex flex-col items-start lg:items-end gap-4 max-w-xs">
      <p class="font-mono-tech text-xs sm:text-sm font-bold text-[#0A0F14]/50 uppercase tracking-widest lg:text-right">
        A chronological record of ventures, research, and impact.
      </p>
      <div class="hidden lg:block w-12 h-12 rounded-full border-2 border-[#0A0F14] flex items-center justify-center animate-bounce mt-4">
        ↓
      </div>
    </div>
  </div>

  <!-- Interactive Row List -->
  <div class="w-full flex flex-col border-t-2 border-[#0A0F14]">
    {milestones.map((item) => (
      <div class={`group flex flex-col lg:flex-row items-start lg:items-center justify-between p-6 sm:px-12 lg:px-16 py-10 lg:py-16 border-b-2 border-[#0A0F14] transition-colors duration-300 ${item.color} cursor-default`}>
        
        <!-- Year (Large) -->
        <div class="w-full lg:w-1/6 mb-6 lg:mb-0">
          <span class="font-heading font-black text-6xl sm:text-7xl lg:text-8xl text-[#0A0F14]/20 group-hover:text-[#0A0F14] transition-colors duration-300 leading-none">
            {item.year}
          </span>
        </div>

        <!-- Title & Tag -->
        <div class="w-full lg:w-2/6 mb-6 lg:mb-0 lg:pr-8">
          <h3 class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl uppercase leading-none mb-3 text-[#0A0F14]">
            {item.title}
          </h3>
          <div class="font-mono-tech text-[10px] font-bold uppercase tracking-widest text-[#0A0F14]/50 group-hover:text-[#0A0F14]/80 transition-colors">
            {item.tag}
          </div>
        </div>

        <!-- Description -->
        <div class="w-full lg:w-2/6 mb-8 lg:mb-0 lg:pr-8">
          <p class="font-sans text-base sm:text-lg text-[#0A0F14]/70 group-hover:text-[#0A0F14] transition-colors leading-relaxed font-medium">
            {item.description}
          </p>
        </div>

        <!-- Metrics & Arrow -->
        <div class="w-full lg:w-1/6 flex justify-between lg:justify-end items-center gap-4">
          <span class="font-mono-tech text-xs font-bold uppercase tracking-widest text-left lg:text-right text-[#0A0F14]">
            {item.metrics}
          </span>
          <span class="text-3xl lg:text-5xl font-light text-[#0A0F14]/30 group-hover:text-[#0A0F14] group-hover:-translate-y-2 group-hover:translate-x-2 transition-all duration-300">
            ↗
          </span>
        </div>

      </div>
    ))}
  </div>

</section>
