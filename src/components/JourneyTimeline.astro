---
const milestones = [
  {
    year: "2024",
    tag: "EDUCATION & COMMUNITY",
    title: "GENIUSPHERE INITIATIVE",
    description: "Launched student technology programs across schools, reaching 200+ students in AI, tech & finance.",
    color: "bg-[#FFD83D]",
    metrics: "200+ STUDENTS • 2 SCHOOLS"
  },
  {
    year: "2025",
    tag: "ENTERPRISE & SYSTEMS",
    title: "ESSMA OS & CLIENT CRM",
    description: "Architected end-to-end CRM and management infrastructure with Supabase, Astro & custom automation engines.",
    color: "bg-[#54D69A]",
    metrics: "142 CLIENTS • 38 PROJECTS"
  },
  {
    year: "2026",
    tag: "VENTURE & TECHNOLOGY",
    title: "BRANDEX OS",
    description: "Building scalable technology solutions & productized business services for digital enterprises.",
    color: "bg-[#4A9EFF]",
    metrics: "END-TO-END TECH & BIZ"
  },
  {
    year: "NOW",
    tag: "EXPERIMENTAL LAB",
    title: "AI & SYSTEM EXPERIMENTS",
    description: "Developing novel AI workflows, micro-SaaS prototypes, and interactive web experiences.",
    color: "bg-[#FF6B22]",
    metrics: "CONTINUOUS R&D"
  }
];
---

<section id="journey" class="w-full py-24 border-b-3 border-[#0A0F14] bg-[#F3F1EB] overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#54D69A] brutal-border font-mono-tech text-xs font-bold mb-4">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [03] CHRONOLOGICAL ARCHIVE
    </div>
    <h2 class="font-heading font-black text-6xl sm:text-8xl uppercase tracking-tighter">
      THE JOURNEY
    </h2>
    <p class="font-mono-tech text-xs sm:text-sm font-bold text-[#0A0F14]/70 mt-2 flex items-center gap-2">
      <span class="w-3 h-3 bg-[#FF6B22] brutal-border inline-block"></span>
      EXPLORE THE HORIZONTAL TIMELINE WORLD — DRAG OR SCROLL
    </p>
  </div>

  <!-- Horizontal Scroll Container -->
  <div class="px-6 sm:px-12 lg:px-16">
    <div class="flex gap-8 overflow-x-auto pb-12 pt-4 no-scrollbar scroll-smooth">
      {milestones.map((item, index) => (
        <div class="min-w-[320px] sm:min-w-[440px] max-w-[460px] bg-white p-8 sm:p-10 brutal-border-xl brutal-shadow-xl flex-shrink-0 flex flex-col justify-between relative group hover:-translate-y-3 transition-all duration-300">
          
          <div>
            <!-- Milestone Year Header -->
            <div class="flex justify-between items-center mb-8 border-b-2 border-[#0A0F14] pb-4">
              <span class={`px-5 py-2 text-3xl font-black font-mono-tech brutal-border brutal-shadow-sm ${item.color}`}>
                {item.year}
              </span>
              <span class="font-mono-tech text-xs uppercase font-bold tracking-widest text-[#0A0F14]/60">
                CHAPTER / 0{index + 1}
              </span>
            </div>

            <!-- Tag -->
            <div class="font-mono-tech text-xs font-bold text-[#FF6B22] uppercase tracking-wider mb-3">
              {item.tag}
            </div>

            <!-- Title -->
            <h3 class="font-heading font-black text-3xl sm:text-4xl uppercase leading-tight mb-4 group-hover:text-[#4A9EFF] transition-colors">
              {item.title}
            </h3>

            <!-- Story Body -->
            <p class="font-sans text-sm sm:text-base text-[#0A0F14]/80 leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <!-- Bottom Visual Metrics & Link -->
          <div class="border-t-2 border-[#0A0F14] pt-4 flex justify-between items-center font-mono-tech text-xs font-bold">
            <span class="px-2.5 py-1 bg-[#F3F1EB] brutal-border">{item.metrics}</span>
            <span class="text-[#0A0F14] group-hover:text-[#FF6B22]">EXPLORE ↗</span>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>
