---
---

<section id="brandex" class="w-full py-20 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#F3F1EB]">
  <div class="max-w-7xl mx-auto">
    
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#4A9EFF] text-[#0A0F14] font-mono-tech text-xs font-bold mb-6 brutal-border">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [05] BRANDEX — CORE VENTURE
    </div>

    <!-- Editorial Header Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      <div class="lg:col-span-7">
        <h2 class="font-heading font-black text-5xl sm:text-7xl lg:text-8xl uppercase leading-[0.85] tracking-tight mb-4 pb-2">
          BRANDEX <br>
          <span class="bg-white px-4 border-2 border-[#0A0F14]">TECH OS</span>
        </h2>
        <p class="font-mono-tech text-xl sm:text-2xl font-bold text-[#FF6B22] uppercase tracking-wide">
          END-TO-END TECHNOLOGY & BUSINESS SOLUTIONS
        </p>
      </div>

      <div class="lg:col-span-5 bg-white p-6 brutal-border-thick brutal-shadow-hover">

        <p class="font-sans text-sm sm:text-base leading-relaxed text-[#0A0F14]/80">
          Brandex operates at the intersection of business strategy and software engineering. We don't just write code — we engineer client CRMs, product automation workflows, and custom enterprise software.
        </p>
      </div>
    </div>

    <!-- 4 Architectural Pillars Visual Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Pillar 1 -->
      <div class="p-6 bg-[#FFD83D] brutal-border-thick brutal-shadow-hover flex flex-col justify-between h-56 cursor-pointer group">
        <div class="font-mono-tech font-bold text-xs uppercase">01 / OPERATIONS</div>
        <div>
          <h3 class="font-heading font-black text-3xl uppercase mb-2 group-hover:translate-x-1 transition-transform">CRM OS</h3>
          <p class="text-xs font-sans text-[#0A0F14]/80">Centralized client data, pipeline tracking & automated follow-ups.</p>
        </div>
        <div class="font-mono-tech text-[10px] font-bold border-t border-[#0A0F14] pt-2">STATUS: DEPLOYED</div>
      </div>

      <!-- Pillar 2 -->
      <div class="p-6 bg-[#54D69A] brutal-border-thick brutal-shadow-hover flex flex-col justify-between h-56 cursor-pointer group">
        <div class="font-mono-tech font-bold text-xs uppercase">02 / AUTOMATION</div>
        <div>
          <h3 class="font-heading font-black text-3xl uppercase mb-2 group-hover:translate-x-1 transition-transform">WORKFLOWS</h3>
          <p class="text-xs font-sans text-[#0A0F14]/80">Zero-latency webhook pipelines connecting payment, messaging & DB.</p>
        </div>

      </div>

      <!-- Pillar 3 -->
      <div class="p-6 bg-[#4A9EFF] text-white brutal-border-thick brutal-shadow-hover flex flex-col justify-between h-56 cursor-pointer group">
        <div class="font-mono-tech font-bold text-xs uppercase">03 / PRODUCTS</div>
        <div>
          <h3 class="font-heading font-black text-3xl uppercase mb-2 group-hover:translate-x-1 transition-transform">SAAS ENGINES</h3>
          <p class="text-xs font-sans text-white/90">Custom micro-services built for rapid business deployment.</p>
        </div>
        <div class="font-mono-tech text-[10px] font-bold border-t border-white/40 pt-2">STATUS: SCALING</div>
      </div>

      <!-- Pillar 4 -->
      <div class="p-6 bg-[#DCC5FF] brutal-border-thick brutal-shadow-hover flex flex-col justify-between h-56 cursor-pointer group">
        <div class="font-mono-tech font-bold text-xs uppercase">04 / CLIENTS</div>
        <div>
          <h3 class="font-heading font-black text-3xl uppercase mb-2 group-hover:translate-x-1 transition-transform">SYSTEMS</h3>
          <p class="text-xs font-sans text-[#0A0F14]/80">Bespoke technical web architectures engineered for high conversion.</p>
        </div>
        <div class="font-mono-tech text-[10px] font-bold border-t border-[#0A0F14] pt-2">STATUS: EXPANDING</div>
      </div>

    </div>

  </div>

  <script>
    import { gsap } from 'gsap';
    const isMobile = window.matchMedia('(max-width: 1024px)').matches;
    if (isMobile) {
      const bCards = document.querySelectorAll('#brandex .group');
      if (bCards.length > 0) {
        let bIndex = 0;
        setInterval(() => {
          const card = bCards[bIndex];
          const title = card.querySelector('h3');
          
          // Hover on
          gsap.to(card, { x: -4, y: -4, boxShadow: '10px 10px 0px #0A0F14', duration: 0.2 });
          if(title) gsap.to(title, { x: 4, duration: 0.2 });

          // Hover off after 800ms
          setTimeout(() => {
            gsap.to(card, { x: 0, y: 0, boxShadow: '4px 4px 0px #0A0F14', duration: 0.3 });
            if(title) gsap.to(title, { x: 0, duration: 0.3 });
          }, 800);

          bIndex = (bIndex + 1) % bCards.length;
        }, 1200);
      }
    }
  </script>
</section>
