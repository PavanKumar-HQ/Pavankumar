---
---

<!-- Floating Centered Pill Dock Navbar with Glassmorphism -->
<header class="fixed top-6 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
  <div class="pointer-events-auto bg-[#0A0F14]/90 backdrop-blur-md text-[#F3F1EB] border-2 border-[#0A0F14] rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4 sm:gap-8 shadow-2xl brutal-shadow-sm max-w-4xl w-full">
    
    <!-- Logo -->
    <a href="#" class="font-bold font-heading text-lg tracking-tighter flex items-center gap-2 group whitespace-nowrap">
      <span class="w-3 h-3 bg-[#FF6B22] rounded-full inline-block group-hover:scale-125 transition-transform"></span>
      <span>PAVAN KUMAR</span>
      <span class="text-[10px] font-mono-tech px-2 py-0.5 bg-[#FFD83D] text-[#0A0F14] rounded-full font-bold">WORLD</span>
    </a>

    <!-- Floating Nav Links -->
    <nav class="hidden md:flex items-center gap-1 font-mono-tech text-xs font-semibold">
      <a href="#about" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#4A9EFF] transition-all">Philosophy</a>
      <a href="#journey" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#FF6B22] transition-all">Journey</a>
      <a href="#work" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#FFD83D] transition-all">Work</a>
      <a href="#brandex" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#4A9EFF] transition-all">Brandex</a>
      <a href="#geniusphere" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#54D69A] transition-all">Geniusphere</a>
      <a href="#writing" class="px-3 py-1.5 rounded-full hover:bg-white/10 hover:text-[#DCC5FF] transition-all">Notes</a>
    </nav>

    <!-- Quick Action Buttons -->
    <div class="flex items-center gap-2">
      <button id="terminal-trigger-btn" class="px-3 py-1 bg-[#FFD83D] text-[#0A0F14] font-bold rounded-full text-xs hover:bg-[#FF6B22] hover:text-white transition-all whitespace-nowrap">
        <span>CMD + K</span>
      </button>
      <a href="#contact" class="px-3.5 py-1 bg-white text-[#0A0F14] font-bold rounded-full text-xs hover:bg-[#4A9EFF] hover:text-white transition-all whitespace-nowrap">
        TALK ↗
      </a>
    </div>

  </div>
</header>

<script>
  // Connect CMD+K trigger button to terminal drawer toggle
  document.getElementById('terminal-trigger-btn')?.addEventListener('click', () => {
    const drawer = document.getElementById('terminal-drawer');
    if (drawer) {
      drawer.classList.toggle('-translate-y-full');
    }
  });
</script>
