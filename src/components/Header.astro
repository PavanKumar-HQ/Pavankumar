<!-- Segmented Grid Navbar (Exact Match to Reference Screenshot) -->
<header class="w-full bg-[#F3F1EB] border-b-2 border-[#0A0F14] sticky top-0 z-50 select-none">
  <div class="max-w-full flex items-stretch divide-x-2 divide-[#0A0F14] overflow-x-auto no-scrollbar font-sans text-xs sm:text-sm font-semibold">
    
    <!-- Active First Item (Blue Highlighted rounded-l) -->
    <a href="#about" data-nav="about" class="grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#4A9EFF] text-[#0A0F14] font-bold transition-colors flex items-center justify-center whitespace-nowrap">
      Overview
    </a>

    <a href="#journey" data-nav="journey" class="grid-nav-item flex-1 min-w-[130px] sm:min-w-[150px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Philosophy
    </a>

    <a href="#work" data-nav="work" class="grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Journey
    </a>

    <a href="#brandex" data-nav="brandex" class="grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Brandex
    </a>

    <a href="#geniusphere" data-nav="geniusphere" class="grid-nav-item flex-1 min-w-[130px] sm:min-w-[150px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Geniusphere
    </a>

    <a href="#writing" data-nav="writing" class="grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Notes
    </a>

    <a href="#contact" data-nav="contact" class="grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap">
      Contact
    </a>

    <!-- Action Right Block (Dark Blue Block + Blue Arrow Icon Pill) -->
    <div class="flex items-stretch divide-x-2 divide-[#0A0F14] ml-auto">
      <a href="#work" class="py-3.5 px-6 bg-[#0A0F14] text-[#F3F1EB] font-bold flex items-center justify-center hover:bg-[#0A0F14]/90 transition-colors whitespace-nowrap">
        View Projects
      </a>
      <a href="#contact" class="py-3.5 px-5 bg-[#4A9EFF] text-[#0A0F14] font-black text-base flex items-center justify-center hover:bg-[#3B8CEB] transition-colors">
        ↗
      </a>
    </div>

  </div>
</header>

<script>
  // Dynamic Scroll Active Section Highlighter matching the Segmented Grid Style
  const sections = document.querySelectorAll('section[id]');
  const gridItems = document.querySelectorAll('.grid-nav-item');

  const observerOptions = {
    root: null,
    rootMargin: '-25% 0px -55% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        if (!id) return;

        gridItems.forEach((item) => {
          if (item.getAttribute('data-nav') === id) {
            item.className = 'grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#4A9EFF] text-[#0A0F14] font-bold transition-colors flex items-center justify-center whitespace-nowrap';
          } else {
            item.className = 'grid-nav-item flex-1 min-w-[120px] sm:min-w-[140px] py-3.5 px-4 text-center bg-[#F3F1EB] text-[#0A0F14] hover:bg-[#0A0F14]/5 transition-colors flex items-center justify-center whitespace-nowrap';
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
</script>
