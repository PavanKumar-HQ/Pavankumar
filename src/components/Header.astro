<script>
  const sections = document.querySelectorAll('section[id]');
  const gridItems = document.querySelectorAll('.grid-nav-item');

  const observerOptions = {
    root: null,
    rootMargin: '-25% 0px -55% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        if (!id) return;
        gridItems.forEach((item) => {
          if (item.getAttribute('data-nav') === id) {
            item.classList.add('bg-[#4A9EFF]', 'font-bold');
            item.classList.remove('bg-[#F3F1EB]');
          } else {
            item.classList.remove('bg-[#4A9EFF]', 'font-bold');
            item.classList.add('bg-[#F3F1EB]');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
</script>
