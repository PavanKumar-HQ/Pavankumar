      <span class="w-2 h-2 rounded-full bg-[#54D69A]"></span>
      PAVAN KUMAR / WORLD
    </span>
    <span>★</span>
    <span class="text-[#FFD83D]">BUILDER & ENTREPRENEUR</span>
    <span>★</span>
    <span class="text-[#4A9EFF]">BRANDEX OS</span>
    <span>★</span>
    <span class="text-[#FF6B22]">GENIUSPHERE 200+ STUDENTS</span>
    <span>★</span>
    <span>ESSMA OS & SUPABASE</span>
    <span>★</span>
    <span class="text-[#DCC5FF]">AI & SYSTEM ARCHITECTURE</span>
    <span>★</span>
    <!-- Duplicate for infinite marquee loop -->
    <span class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#54D69A]"></span>
      PAVAN KUMAR / WORLD
    </span>
    <span>★</span>
    <span class="text-[#FFD83D]">BUILDER & ENTREPRENEUR</span>
    <span>★</span>
    <span class="text-[#4A9EFF]">BRANDEX OS</span>
    <span>★</span>
    <span class="text-[#FF6B22]">GENIUSPHERE 200+ STUDENTS</span>
    <span>★</span>
    <span>ESSMA OS & SUPABASE</span>
    <span>★</span>
    <span class="text-[#DCC5FF]">AI & SYSTEM ARCHITECTURE</span>
    <span>★</span>
  </div>
</div>

<header class="w-full border-b-3 border-[#0A0F14] bg-[#F3F1EB] sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex justify-between items-center font-mono-tech text-xs sm:text-sm">
    <a href="#" class="font-bold font-heading text-xl sm:text-2xl tracking-tighter flex items-center gap-2 group">
      <span class="w-4 h-4 bg-[#FF6B22] brutal-border inline-block group-hover:rotate-45 transition-transform"></span>
      PAVAN KUMAR <span class="text-xs px-2.5 py-0.5 bg-[#FFD83D] brutal-border">WORLD</span>
    </a>
    
    <nav class="hidden md:flex items-center gap-6 font-bold">
      <a href="#about" class="hover:text-[#4A9EFF] hover:underline underline-offset-4 transition-all">01.PHILOSOPHY</a>
      <a href="#journey" class="hover:text-[#4A9EFF] hover:underline underline-offset-4 transition-all">02.JOURNEY</a>
      <a href="#work" class="hover:text-[#4A9EFF] hover:underline underline-offset-4 transition-all">03.BUILT_WORK</a>
      <a href="#systems" class="hover:text-[#4A9EFF] hover:underline underline-offset-4 transition-all">04.SYSTEMS</a>
      <a href="#writing" class="hover:text-[#4A9EFF] hover:underline underline-offset-4 transition-all">05.NOTES</a>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-2 px-3 py-1 bg-[#54D69A]/30 brutal-border text-[11px] font-bold">
        <span class="w-2 h-2 rounded-full bg-[#54D69A] animate-ping"></span>
        STATUS: ACTIVE
      </div>
      <button id="terminal-trigger-btn" class="px-3 py-1.5 bg-[#FFD83D] text-[#0A0F14] font-bold brutal-border text-xs flex items-center gap-1 hover:bg-[#FF6B22] transition-colors">
        <span>CMD + K</span>
      </button>
      <a href="#contact" class="px-4 py-2 bg-[#0A0F14] text-[#F3F1EB] font-bold brutal-shadow-hover hover:bg-[#4A9EFF] hover:text-[#0A0F14] transition-all brutal-border">
        TALK ↗
      </a>
    </div>
  </div>
</header>

<script>
  // Connect CMD+K trigger button to terminal drawer toggle
  document.getElementById('terminal-trigger-btn')?.addEventListener('click', () => {
    const drawer = document.getElementById('terminal-drawer');
    if (drawer) {
      drawer.classList.toggle('-translate-y-full');
    }
  });
</script>
