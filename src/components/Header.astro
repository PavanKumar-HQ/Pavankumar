---

<header id="main-nav" class="w-full bg-[#F3F1EB] border-b-2 border-[#0A0F14] sticky top-0 z-50 transition-all duration-300 font-mono-tech select-none">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 flex items-center justify-between h-16 sm:h-20">
    
    <!-- Anchor Name (Left) -->
    <a href="#" class="font-heading font-black text-xl sm:text-2xl text-[#0A0F14] tracking-tight hover:text-[#4A9EFF] transition-colors whitespace-nowrap">
      PAVAN KUMAR S
    </a>

    <!-- Navigation Links (Center/Right) -->
    <div class="hidden lg:flex items-center gap-8 text-xs sm:text-sm font-bold text-[#0A0F14]/70 uppercase tracking-widest">
      <a href="#about" data-nav="about" class="nav-item hover:text-[#0A0F14] transition-colors relative pb-1">
        ABOUT
      </a>
      <a href="#experience" data-nav="experience" class="nav-item hover:text-[#0A0F14] transition-colors relative pb-1">
        WORK
      </a>
      <a href="#geniusphere" data-nav="geniusphere" class="nav-item hover:text-[#0A0F14] transition-colors relative pb-1">
        GENIUSPHERE
      </a>
      <a href="#skills" data-nav="skills" class="nav-item hover:text-[#0A0F14] transition-colors relative pb-1">
        EXPLORE
      </a>
      <a href="#contact" data-nav="contact" class="nav-item hover:text-[#0A0F14] transition-colors relative pb-1">
        CONTACT
      </a>
    </div>

    <!-- Right Action (Let's Talk) -->
    <a href="#contact" class="hidden sm:flex items-center gap-2 bg-[#0A0F14] text-[#FFD83D] px-5 py-2 font-bold text-xs sm:text-sm hover:bg-[#4A9EFF] hover:text-[#0A0F14] transition-colors border-2 border-[#0A0F14]">
      LET'S TALK ↗
    </a>

  </div>
</header>

<style>
  /* Active indicator style */
  .nav-item.active {
    color: #0A0F14;
  }
  .nav-item.active::after {
    content: '●';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 8px;
    color: #4A9EFF;
  }
</style>

<script>
  // Simple Intersection Observer for Active Links
  const sections = document.querySelectorAll('section[id]');
  const navItems = document.querySelectorAll('.nav-item');

  const observerOptions = {
    root: null,
    rootMargin: '-25% 0px -55% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        if (!id) return;

        navItems.forEach((item) => {
          if (item.getAttribute('data-nav') === id) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));

  // Shrink navbar on scroll
  const header = document.getElementById('main-nav');
  const innerDiv = header.querySelector('div');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      innerDiv.classList.remove('h-16', 'sm:h-20');
      innerDiv.classList.add('h-14', 'sm:h-16');
    } else {
      innerDiv.classList.add('h-16', 'sm:h-20');
      innerDiv.classList.remove('h-14', 'sm:h-16');
    }
  });
</script>
