---
---

<section id="contact" class="w-full border-b-2 border-[#0A0F14] bg-[#FF6B22] overflow-hidden">

  <!-- Top label strip -->
  <div class="border-b-2 border-[#0A0F14] px-8 sm:px-16 py-4 flex items-center gap-6">
    <span class="font-mono-tech text-[10px] font-bold text-[#0A0F14] uppercase tracking-[0.25em]">06 / CONTACT</span>
    <div class="h-px flex-1 bg-[#0A0F14]/20"></div>
    <span class="font-mono-tech text-[10px] font-bold text-[#0A0F14]/50 uppercase tracking-[0.25em]">OPEN TO COLLABS</span>
  </div>

  <!-- Main -->
  <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] border-b-2 border-[#0A0F14]">

    <!-- Left: big CTA -->
    <div class="px-8 sm:px-16 py-16 border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0F14] flex flex-col justify-between gap-10">
      <h2 class="font-heading font-black text-[clamp(3.5rem,9vw,7.5rem)] uppercase leading-[0.88] tracking-tight text-[#0A0F14]">
        GOT SOMETHING<br>
        <span class="bg-[#0A0F14] text-[#FF6B22] px-4 inline-block -skew-x-2">INTERESTING?</span>
      </h2>
      <div class="space-y-4">
        <p class="font-sans text-base sm:text-lg text-[#0A0F14] max-w-md leading-relaxed">
          Whether it's a project, an idea, a collab, or just a conversation — I'm around.
        </p>
        <a href="mailto:contact@pavankumarworld.com"
           class="inline-flex items-center gap-3 bg-[#0A0F14] text-[#FFD83D] font-heading font-black text-2xl sm:text-3xl uppercase px-8 py-5 border-2 border-[#0A0F14] hover:bg-[#FFD83D] hover:text-[#0A0F14] transition-colors group brutal-shadow-xl">
          LET'S TALK
          <span class="group-hover:translate-x-2 transition-transform">↗</span>
        </a>
        <div class="font-mono-tech text-xs text-[#0A0F14]/60 pt-2">
          contact@pavankumarworld.com
        </div>
      </div>
    </div>

    <!-- Right: links -->
    <div class="flex flex-col divide-y-2 divide-[#0A0F14]">
      <a href="https://www.linkedin.com/in/pavankumar-hq" target="_blank"
         class="flex items-center justify-between px-8 py-7 font-heading font-black text-xl uppercase text-[#0A0F14] hover:bg-[#0A0F14] hover:text-[#FF6B22] transition-colors group">
        LINKEDIN
        <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
      </a>
      <a href="https://github.com/PavanKumar-HQ" target="_blank"
         class="flex items-center justify-between px-8 py-7 font-heading font-black text-xl uppercase text-[#0A0F14] hover:bg-[#0A0F14] hover:text-[#FF6B22] transition-colors group">
        GITHUB
        <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
      </a>
      <a href="https://x.com/PavanKumarHQ" target="_blank"
         class="flex items-center justify-between px-8 py-7 font-heading font-black text-xl uppercase text-[#0A0F14] hover:bg-[#0A0F14] hover:text-[#FF6B22] transition-colors group">
        X / TWITTER
        <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
      </a>
      <a href="mailto:contact@pavankumarworld.com"
         class="flex items-center justify-between px-8 py-7 font-heading font-black text-xl uppercase bg-[#FFD83D] text-[#0A0F14] hover:bg-[#0A0F14] hover:text-[#FFD83D] transition-colors group border-t-2 border-[#0A0F14]">
        EMAIL DIRECT
        <span class="font-mono-tech text-sm group-hover:translate-x-1 transition-transform">↗</span>
      </a>
    </div>

  </div>

  <!-- Bottom availability bar -->
  <div class="px-8 sm:px-16 py-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 bg-[#0A0F14] animate-pulse inline-block"></span>
      <span class="font-mono-tech text-xs font-bold text-[#0A0F14] uppercase tracking-widest">AVAILABLE FOR COLLABS, INTERNSHIPS & IDEAS</span>
    </div>
    <span class="font-mono-tech text-[10px] text-[#0A0F14]/50 uppercase tracking-widest">BENGALURU, INDIA · GMT+5:30</span>
  </div>

</section>

<!-- ══════════════ FOOTER ══════════════ -->
<footer class="w-full bg-[#0A0F14] text-[#F3F1EB]">

  <!-- Top footer grid -->
  <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] divide-y-2 md:divide-y-0 md:divide-x-2 divide-[#F3F1EB]/10 border-b-2 border-[#F3F1EB]/10">

    <!-- Brand -->
    <div class="px-8 sm:px-16 py-12 space-y-4">
      <div class="font-heading font-black text-3xl sm:text-4xl text-[#F3F1EB] uppercase">PAVAN KUMAR</div>
      <p class="font-sans text-sm text-[#F3F1EB]/50 max-w-xs leading-relaxed">
        BCA student, founder of Geniusphere, co-founder of Brandex — building things that actually matter.
      </p>
      <div class="font-mono-tech text-[10px] text-[#F3F1EB]/30 uppercase tracking-widest pt-2">
        BENGALURU, KARNATAKA, INDIA
      </div>
    </div>

    <!-- Nav -->
    <div class="px-8 py-12 space-y-3">
      <div class="font-mono-tech text-[10px] font-bold text-[#F3F1EB]/30 uppercase tracking-widest mb-5">NAVIGATE</div>
      {["Home", "About", "Work", "Geniusphere", "Explore", "Contact"].map((item) => (
        <a href={`#${item.toLowerCase()}`}
           class="block font-mono-tech text-xs font-bold text-[#F3F1EB]/60 hover:text-[#FFD83D] transition-colors uppercase tracking-wide">
          {item}
        </a>
      ))}
    </div>

    <!-- Built with -->
    <div class="px-8 py-12 space-y-3">
      <div class="font-mono-tech text-[10px] font-bold text-[#F3F1EB]/30 uppercase tracking-widest mb-5">BUILT WITH</div>
      {["Astro", "Tailwind CSS", "TypeScript", "GSAP"].map((tech) => (
        <div class="font-mono-tech text-xs text-[#F3F1EB]/50 uppercase tracking-wide">{tech}</div>
      ))}
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="px-8 sm:px-16 py-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <span class="font-mono-tech text-[10px] text-[#F3F1EB]/30 uppercase tracking-widest">
      © 2026 PAVAN KUMAR — ALL RIGHTS RESERVED
    </span>
    <span class="font-mono-tech text-[10px] text-[#FFD83D]/60 uppercase tracking-widest">
      DESIGNED & BUILT BY PAVAN KUMAR ↗
    </span>
  </div>

</footer>
