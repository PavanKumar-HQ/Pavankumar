---
---

<div id="loader" class="fixed inset-0 z-50 bg-[#F3F1EB] bg-grid-pattern text-[#0A0F14] flex flex-col justify-between p-6 sm:p-12 font-mono-tech transition-all duration-700 select-none">
  
  <div class="flex justify-between items-center text-xs font-bold tracking-widest uppercase border-b-2 border-[#0A0F14] pb-4">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#FF6B22] animate-ping"></span>
      <span class="font-bold">[ARCHIVE_INIT]</span>
    </div>
    <span class="px-2 py-0.5 bg-[#0A0F14] text-[#FFD83D]">2026 EDITION</span>
  </div>

  <!-- Central High Impact Neo-Brutalist Typography Reveal -->
  <div class="my-auto flex flex-col items-center justify-center text-center">
    <div class="font-heading font-black text-6xl sm:text-8xl md:text-9xl tracking-tighter uppercase leading-none mb-2 text-[#0A0F14]">
      PAVAN
    </div>
    
    <div class="inline-block bg-[#FFD83D] text-[#0A0F14] px-6 py-2 brutal-border-thick -rotate-3 shadow-[8px_8px_0px_0px_#0A0F14] animate-bounce">
      <span class="font-heading font-black text-6xl sm:text-8xl md:text-9xl tracking-tighter uppercase leading-none">
        KUMAR
      </span>
    </div>
  </div>

  <!-- Bottom Loader Progress Bar -->
  <div class="max-w-xl mx-auto w-full">
    <div class="w-full bg-white h-6 brutal-border-thick p-1 mb-3">
      <div id="loader-bar" class="h-full bg-[#FF6B22] w-0 transition-all duration-100 ease-out"></div>
    </div>
    
    <div class="flex justify-between text-xs font-bold font-mono-tech">
      <span id="loader-status" class="uppercase">INITIALIZING SYSTEM...</span>
      <span id="loader-percent" class="px-2 py-0.5 bg-[#0A0F14] text-[#FFD83D]">0%</span>
    </div>
  </div>

</div>

<script>
  let progress = 0;
  const bar = document.getElementById('loader-bar');
  const percent = document.getElementById('loader-percent');
  const loader = document.getElementById('loader');
  const status = document.getElementById('loader-status');

  const steps = [
    'BUILDING_EXPERIENCE...',
    'LOADING_GENIUSPHERE...',
    'COMPILING_INTERACTION...',
    'READY'
  ];

  const interval = setInterval(() => {
    progress += Math.floor(Math.random() * 18) + 8;
    if (progress > 100) progress = 100;
    
    if (bar && percent) {
      bar.style.width = `${progress}%`;
      percent.innerText = `${progress}%`;
    }

    if (status) {
      const stepIdx = Math.min(Math.floor((progress / 100) * steps.length), steps.length - 1);
      status.innerText = steps[stepIdx];
    }

    if (progress === 100) {
      clearInterval(interval);
      setTimeout(() => {
        if (loader) {
          loader.style.transform = 'translateY(-100%)';
          setTimeout(() => {
            loader.style.display = 'none';
          }, 700);
        }
      }, 400);
    }
  }, 80);
</script>
