---
const statuses = [
  { label: "BUILDING", val: "BRANDEX OS & CLIENT CRM", color: "bg-[#4A9EFF] text-white" },
  { label: "RUNNING", val: "GENIUSPHERE STUDENT INITIATIVES", color: "bg-[#FFD83D] text-[#0A0F14]" },
  { label: "LEARNING", val: "AI AGENTS × DISTRIBUTED SYSTEM DESIGN", color: "bg-[#54D69A] text-[#0A0F14]" },
  { label: "EXPLORING", val: "WHAT'S NEXT IN QUANTUM & WEB INTERACTION", color: "bg-[#DCC5FF] text-[#0A0F14]" }
];
---

<section id="currently" class="w-full py-20 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#0A0F14] text-[#F3F1EB]">
  <div class="max-w-7xl mx-auto">
    
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FF6B22] text-[#0A0F14] font-mono-tech text-xs font-bold mb-6 brutal-border">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [10] LIVE STATUS TICKER
    </div>

    <h2 class="font-heading font-black text-5xl sm:text-7xl uppercase tracking-tighter text-[#F3F1EB] mb-10">
      CURRENTLY:
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {statuses.map((item) => (
        <div class="p-6 bg-[#121820] border-2 border-[#F3F1EB]/30 brutal-shadow-hover flex flex-col justify-between h-48 cursor-pointer group hover:bg-[#F3F1EB] hover:text-[#0A0F14] transition-all duration-200">
          <div>
            <span class={`inline-block px-2.5 py-1 text-[11px] font-mono-tech font-bold brutal-border tracking-wider ${item.color}`}>
              {item.label}
            </span>
            <div class="font-heading font-black text-xl sm:text-2xl mt-4 leading-tight group-hover:text-[#0A0F14] transition-colors">
              {item.val}
            </div>
          </div>

          <div class="font-mono-tech text-[11px] text-[#F3F1EB]/50 group-hover:text-[#0A0F14]/70 border-t border-current/20 pt-3 flex items-center gap-2 font-bold transition-colors">
            <span class="w-2 h-2 rounded-full bg-[#54D69A] animate-pulse"></span>
            UPDATED: RECENTLY
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
