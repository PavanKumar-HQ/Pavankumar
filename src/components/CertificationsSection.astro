---
const certs = [
  {
    title: "Python for Data Science",
    issuer: "Analogical / Online",
    category: "DATA SCIENCE",
    color: "bg-[#FFD83D]"
  },
  {
    title: "Build Your Generative AI",
    issuer: "Microsoft & LinkedIn",
    category: "GENERATIVE AI",
    color: "bg-[#54D69A]"
  },
  {
    title: "Career Essentials in Cybersecurity",
    issuer: "Microsoft & LinkedIn",
    category: "CYBERSECURITY",
    color: "bg-[#4A9EFF] text-white"
  },
  {
    title: "Productivity Skills",
    issuer: "Microsoft & LinkedIn",
    category: "PRODUCTIVITY",
    color: "bg-[#DCC5FF]"
  }
];
---

<section id="certifications" class="w-full py-20 px-6 sm:px-12 lg:px-16 border-b-3 border-[#0A0F14] bg-[#F3F1EB]">
  <div class="max-w-7xl mx-auto">
    
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#54D69A] text-[#0A0F14] font-mono-tech text-xs font-bold mb-6 brutal-border">
      <span class="w-2 h-2 bg-[#0A0F14]"></span>
      [05] CERTIFICATIONS & CREDENTIALS
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b-2 border-[#0A0F14] pb-6">
      <div>
        <h2 class="font-heading font-black text-5xl sm:text-7xl uppercase tracking-tight">
          CERTIFICATIONS
        </h2>
        <p class="font-mono-tech text-xs sm:text-sm text-[#0A0F14]/70 mt-2">
          VERIFIED SKILL CREDENTIALS IN AI, PYTHON & CYBERSECURITY
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {certs.map((cert) => (
        <div class="bg-white p-6 brutal-border-thick brutal-shadow-hover flex flex-col justify-between group">
          <div>
            <span class={`inline-block px-2.5 py-1 text-[11px] font-mono-tech font-bold brutal-border uppercase mb-4 ${cert.color}`}>
              {cert.category}
            </span>
            <h3 class="font-heading font-black text-2xl uppercase leading-tight group-hover:text-[#FF6B22] transition-colors mb-2">
              {cert.title}
            </h3>
            <p class="font-mono-tech text-xs text-[#0A0F14]/60">
              ISSUED BY: {cert.issuer}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#0A0F14]/20 flex justify-between items-center font-mono-tech text-xs font-bold">
            <span>VERIFIED Credential</span>
            <span class="text-[#54D69A]">✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
